<!-- Dark theme palette: EVERY colour of the dark theme lives here and nowhere else.
     Read by Services/Theme.cs: each "Theme.X" key becomes an application resource (XAML uses
     {DynamicResource Theme.X}) and recolours the brush Theme.X that code-behind uses.
     The other theme has its own copy of this file with the same keys — editing this one
     cannot change a pixel of the other theme. A key missing here keeps the other theme's
     colour after a switch (Theme.Apply logs it), so add a new key to BOTH files. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Which library theme (WPF-UI ThemesDictionary) goes with this palette. -->
    <sys:String x:Key="Theme.LibraryTheme">Dark</sys:String>

    <!-- ===== Surfaces ===== -->
    <SolidColorBrush x:Key="Theme.WindowBg" Color="#FF1B1B1F" />
    <SolidColorBrush x:Key="Theme.CardBg" Color="#FF2A2A30" />
    <SolidColorBrush x:Key="Theme.CardBgHover" Color="#FF34343C" />
    <SolidColorBrush x:Key="Theme.CardBorder" Color="#FF3C3C46" />
    <SolidColorBrush x:Key="Theme.CardBorderHover" Color="#FF5E82C4" />

    <!-- ===== The one accent ===== -->
    <Color x:Key="Theme.AccentColor">#FF5E82C4</Color>
    <SolidColorBrush x:Key="Theme.Accent" Color="#FF5E82C4" />
    <SolidColorBrush x:Key="Theme.AccentSoft" Color="#FF323D54" />
    <SolidColorBrush x:Key="Theme.AccentSoftHover" Color="#FF3E4B64" />

    <!-- ===== Tables (DataGrid, the code-drawn tables, the implicit ListView style) ===== -->
    <SolidColorBrush x:Key="Theme.ListBg" Color="#FF1F1F24" />
    <SolidColorBrush x:Key="Theme.SelectionBg" Color="#4D5E82C4" />
    <SolidColorBrush x:Key="Theme.TableHeaderBg" Color="#FF26262C" />
    <SolidColorBrush x:Key="Theme.TableLine" Color="#FF303038" />
    <SolidColorBrush x:Key="Theme.TableRowAlt" Color="#FF232329" />
    <SolidColorBrush x:Key="Theme.TableRowHover" Color="#FF2B2B33" />
    <SolidColorBrush x:Key="Theme.TableRowSelected" Color="#FF323D54" />

    <!-- ===== Buttons: default, primary (library + Accent), «add» (AccentGreen text), danger ===== -->
    <SolidColorBrush x:Key="Theme.DangerBg" Color="#FF7D3A3A" />
    <SolidColorBrush x:Key="Theme.DangerBgHover" Color="#FF914444" />

    <!-- ===== Tiles ===== -->
    <SolidColorBrush x:Key="Theme.TileBg" Color="#FF2A2A30" />
    <SolidColorBrush x:Key="Theme.TileBgHover" Color="#FF313A4E" />
    <SolidColorBrush x:Key="Theme.TileBorder" Color="#FF3C3C46" />
    <SolidColorBrush x:Key="Theme.TileBorderHover" Color="#FF5E82C4" />
    <SolidColorBrush x:Key="Theme.TileDisabledBg" Color="#FF222226" />
    <SolidColorBrush x:Key="Theme.TileDisabledBorder" Color="#FF2E2E34" />
    <SolidColorBrush x:Key="Theme.ChipBg" Color="#09FFFFFF" />
    <SolidColorBrush x:Key="Theme.ChipBorder" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="Theme.ChipBgHover" Color="#2E5E82C4" />
    <SolidColorBrush x:Key="Theme.PlateGreenBg" Color="#1A8FB89B" />
    <SolidColorBrush x:Key="Theme.PlateGreenBorder" Color="#428FB89B" />
    <SolidColorBrush x:Key="Theme.PlateGreenBgHover" Color="#338FB89B" />
    <SolidColorBrush x:Key="Theme.PlateGreenBorderHover" Color="#808FB89B" />
    <SolidColorBrush x:Key="Theme.PlateAmberBg" Color="#1AD9BC8C" />
    <SolidColorBrush x:Key="Theme.PlateAmberBorder" Color="#4DD9BC8C" />
    <SolidColorBrush x:Key="Theme.PlateAmberBgHover" Color="#33D9BC8C" />
    <SolidColorBrush x:Key="Theme.PlateAmberBorderHover" Color="#8CD9BC8C" />
    <SolidColorBrush x:Key="Theme.PlateRedBg" Color="#1AD98C84" />
    <SolidColorBrush x:Key="Theme.PlateRedBorder" Color="#4DD98C84" />
    <SolidColorBrush x:Key="Theme.PlateRedBgHover" Color="#33D98C84" />
    <SolidColorBrush x:Key="Theme.PlateRedBorderHover" Color="#8CD98C84" />
    <SolidColorBrush x:Key="Theme.PlateNeutralBg" Color="#08FFFFFF" />
    <SolidColorBrush x:Key="Theme.PlateNeutralBorder" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="Theme.PickerBorder" Color="#FF45454F" />
    <SolidColorBrush x:Key="Theme.PickerRowHover" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="Theme.PickerRowCurrent" Color="#0DFFFFFF" />

    <!-- ===== Text ===== -->
    <SolidColorBrush x:Key="Theme.TextPrimary" Color="#FFF1F1F4" />
    <SolidColorBrush x:Key="Theme.TextSecondary" Color="#FFA2A2AC" />
    <SolidColorBrush x:Key="Theme.TextMuted" Color="#FF74747E" />
    <SolidColorBrush x:Key="Theme.TextDisabled" Color="#FF6E6E78" />

    <!-- ===== Accents (tile sub-labels, status text) ===== -->
    <SolidColorBrush x:Key="Theme.AccentGreen" Color="#FF8FB89B" />
    <SolidColorBrush x:Key="Theme.AccentRed" Color="#FFD98C84" />
    <SolidColorBrush x:Key="Theme.ConflictIcon" Color="#FFB06A64" />
    <SolidColorBrush x:Key="Theme.AccentAmber" Color="#FFD9BC8C" />
    <SolidColorBrush x:Key="Theme.NoticeAmber" Color="#FFD9BC8C" />
    <SolidColorBrush x:Key="Theme.NoticeTileBorder" Color="#8CD9BC8C" />
    <SolidColorBrush x:Key="Theme.AccentBlue" Color="#FFAAB9D6" />
    <SolidColorBrush x:Key="Theme.AccentGrey" Color="#FF8A909A" />
    <SolidColorBrush x:Key="Theme.SpeedRed" Color="#FFEF6B6B" />
    <SolidColorBrush x:Key="Theme.SpeedAmber" Color="#FFE9B64E" />
    <SolidColorBrush x:Key="Theme.SpeedGreen" Color="#FF6FCF8F" />
    <SolidColorBrush x:Key="Theme.SpeedBlue" Color="#FF5AA9FF" />
    <SolidColorBrush x:Key="Theme.SpeedTrack" Color="#FF45454A" />
    <SolidColorBrush x:Key="Theme.ChipIconBright" Color="#FFD6D6DA" />
    <SolidColorBrush x:Key="Theme.NicWifiOk" Color="#FF5B86E5" />
    <SolidColorBrush x:Key="Theme.NicWiredOk" Color="#FF7FD39B" />
    <SolidColorBrush x:Key="Theme.NicTrouble" Color="#FFEC8A4B" />
    <SolidColorBrush x:Key="Theme.NicOff" Color="#FFCFC8E3" />
    <SolidColorBrush x:Key="Theme.GuardBorder" Color="#99A78BFA" />
    <Color x:Key="Theme.GuardSwitchFill">#99A78BFA</Color>
    <Color x:Key="Theme.GuardSwitchFillHover">#BFA78BFA</Color>

    <!-- ===== Banner: info (idle) — calm slate-blue ===== -->
    <SolidColorBrush x:Key="Theme.BannerInfoBg" Color="#FF20242E" />
    <SolidColorBrush x:Key="Theme.BannerInfoBorder" Color="#FF333B49" />
    <SolidColorBrush x:Key="Theme.BannerInfoText" Color="#FFAAB9D6" />

    <!-- ===== Banner: success — subtle, not a wall of green ===== -->
    <SolidColorBrush x:Key="Theme.BannerOkBg" Color="#FF1C241F" />
    <SolidColorBrush x:Key="Theme.BannerOkBorder" Color="#FF323D34" />
    <SolidColorBrush x:Key="Theme.BannerOkText" Color="#FFA0C0A9" />

    <!-- ===== Banner: warning ===== -->
    <SolidColorBrush x:Key="Theme.BannerWarnBg" Color="#FF2E2719" />
    <SolidColorBrush x:Key="Theme.BannerWarnBorder" Color="#FF564A2A" />
    <SolidColorBrush x:Key="Theme.BannerWarnText" Color="#FFD9BC8C" />

    <!-- ===== Badge: neutral (VPN not in use) ===== -->
    <SolidColorBrush x:Key="Theme.BadgeNeutralBg" Color="#FF26262C" />
    <SolidColorBrush x:Key="Theme.BadgeNeutralBorder" Color="#FF3C3C46" />
    <SolidColorBrush x:Key="Theme.BadgeNeutralText" Color="#FFA2A2AC" />

    <!-- ===== Placeholder glyph (no icon) ===== -->
    <SolidColorBrush x:Key="Theme.PlaceholderBg" Color="#FF26344E" />
    <SolidColorBrush x:Key="Theme.PlaceholderText" Color="#FF93ABDA" />

    <!-- ===== Overlays (in-window dialogs) ===== -->
    <SolidColorBrush x:Key="Theme.OverlayScrim" Color="#FF1B1B1F" />
    <SolidColorBrush x:Key="Theme.OverlayBackdrop" Color="#99000000" />
    <SolidColorBrush x:Key="Theme.OverlayCardBg" Color="#FF2C2C33" />
    <SolidColorBrush x:Key="Theme.OverlayBody" Color="#FFC9C9D2" />

    <!-- ===== Shadow ===== -->
    <Color x:Key="Theme.ShadowColor">#66000000</Color>
    <Color x:Key="Theme.ShadowBase">#FF000000</Color>

    <!-- ===== Text on coloured fills ===== -->
    <SolidColorBrush x:Key="Theme.TextOnAction" Color="#FFEAF1FF" />
    <SolidColorBrush x:Key="Theme.TextOnColor" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Theme.TabCloseGlyph" Color="#FFFFFFFF" />

    <!-- ===== Main window: the action row (named 2026-11-22; values as they were) ===== -->
    <SolidColorBrush x:Key="Theme.ActionDangerHover" Color="#FF6E3A3A" />
    <SolidColorBrush x:Key="Theme.SafeModeBg" Color="#FF323D54" />
    <SolidColorBrush x:Key="Theme.SafeModeCountdown" Color="#FFEAF1FF" />
    <SolidColorBrush x:Key="Theme.SafeModeLabel" Color="#FFEAF1FF" />
    <Color x:Key="Theme.SafeModeSwitchFill">#99D98C84</Color>
    <Color x:Key="Theme.SafeModeSwitchFillHover">#BFD98C84</Color>
    <SolidColorBrush x:Key="Theme.EngineBtnBg" Color="#FF6E5A33" />
    <SolidColorBrush x:Key="Theme.EngineBtnHover" Color="#FF80683B" />
    <SolidColorBrush x:Key="Theme.EngineBtnText" Color="#FFF3E7CC" />
    <SolidColorBrush x:Key="Theme.ChipDangerBgHover" Color="#FF5C3030" />
    <SolidColorBrush x:Key="Theme.ChipDangerBorderHover" Color="#FF804444" />

    <!-- ===== VPN priority squares (rule editor, routing matrix) ===== -->
    <SolidColorBrush x:Key="Theme.RankOnBg" Color="#FF3C6149" />
    <SolidColorBrush x:Key="Theme.RankOnBorder" Color="#FF588A69" />
    <SolidColorBrush x:Key="Theme.RankOffBorder" Color="#FF555F77" />
    <SolidColorBrush x:Key="Theme.GuardCellBg" Color="#FF564C77" />
    <SolidColorBrush x:Key="Theme.AccentViolet" Color="#FFA78BFA" />

    <!-- ===== Identity colours: a tile's monogram, a company badge in DNS statistics ===== -->
    <SolidColorBrush x:Key="Theme.BadgeGreyBg" Color="#FF3A3A42" />

    <!-- ===== Lists drawn on a card (DNS statistics): stripes and rules over CardBg ===== -->
    <SolidColorBrush x:Key="Theme.ListStripeOnCard" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="Theme.ListLineOnCard" Color="#1CFFFFFF" />

    <!-- ===== The speed chart ===== -->
    <SolidColorBrush x:Key="Theme.ChartGrid" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="Theme.ChartZeroLine" Color="#38FFFFFF" />
    <SolidColorBrush x:Key="Theme.ChartGuide" Color="#46FFFFFF" />
    <Color x:Key="Theme.ChartUpColor">#FFC9CBD6</Color>

    <!-- ===== Identity colours: a tile's monogram, a company badge (white text on them) ===== -->
    <Color x:Key="Theme.Monogram0">#FF3F6FD8</Color>
    <Color x:Key="Theme.Monogram1">#FF2F9A6B</Color>
    <Color x:Key="Theme.Monogram2">#FFC26A2E</Color>
    <Color x:Key="Theme.Monogram3">#FF875CCF</Color>
    <Color x:Key="Theme.Monogram4">#FFC04B5C</Color>
    <Color x:Key="Theme.Monogram5">#FF2A8EA8</Color>
    <Color x:Key="Theme.Monogram6">#FF9C7C2C</Color>
    <Color x:Key="Theme.Monogram7">#FF5E6B84</Color>

    <!-- ===== The library inside the palette =====
         WPF-UI draws cards, popups, menus, tooltips and the window with its own greys (partly
         semi-transparent). These keys of its control templates take this palette's tokens. -->
    <!-- Window. WindowFace = what a window's background actually shows. The library paints every
         window with its own colour when it is shown and on every theme switch, over the window's
         Background (found 2026-11-24: 3.1.6 showed the library's #202020, not WindowBg);
         Theme.ApplyFrame then puts WindowFace back. Dark keeps the library's #202020, so the
         dark theme looks exactly as it did. -->
    <SolidColorBrush x:Key="Theme.WindowFace" Color="#FF202020" />
    <SolidColorBrush x:Key="WindowBackground" Color="#FF1B1B1F" />
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#FF1B1B1F" />
    <!-- ui:Card / CardExpander: a raised surface with the outline -->
    <SolidColorBrush x:Key="CardBackground" Color="#FF2A2A30" />
    <SolidColorBrush x:Key="CardBackgroundPointerOver" Color="#FF34343C" />
    <SolidColorBrush x:Key="CardBackgroundPressed" Color="#FF2A2A30" />
    <SolidColorBrush x:Key="CardBackgroundDisabled" Color="#FF2A2A30" />
    <SolidColorBrush x:Key="CardFooterBackground" Color="#FF2A2A30" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#FF3C3C46" />
    <SolidColorBrush x:Key="CardBorderBrushPressed" Color="#FF3C3C46" />
    <SolidColorBrush x:Key="CardBorderBrushDisabled" Color="#FF3C3C46" />
    <!-- Floating: context menus, sub-menus, tooltips, dropdowns, dialogs, snackbars -->
    <SolidColorBrush x:Key="ContextMenuBackground" Color="#FF2C2C33" />
    <SolidColorBrush x:Key="ContextMenuBorderBrush" Color="#FF45454F" />
    <SolidColorBrush x:Key="FlyoutBackground" Color="#FF2C2C33" />
    <SolidColorBrush x:Key="FlyoutBorderBrush" Color="#FF45454F" />
    <SolidColorBrush x:Key="ToolTipBackground" Color="#FF2C2C33" />
    <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#FF45454F" />
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FF2C2C33" />
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#FF45454F" />
    <SolidColorBrush x:Key="ContentDialogBackground" Color="#FF2C2C33" />
    <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="#FF45454F" />
    <SolidColorBrush x:Key="SnackBarBackground" Color="#FF2C2C33" />
    <SolidColorBrush x:Key="SnackBarBorderBrush" Color="#FF45454F" />
    <!-- Opaque greys inside controls -->
    <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="#FF2C2C33" />
    <SolidColorBrush x:Key="SliderOuterThumbBackground" Color="#FF45454F" />
    <!-- Primary text: the app's, not the library's -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFF1F1F4" />
</ResourceDictionary>
