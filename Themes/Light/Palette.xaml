<!-- Light theme palette: EVERY colour of the light theme lives here and nowhere else.
     Read by Services/Theme.cs: each "Theme.X" key becomes an application resource (XAML uses
     {DynamicResource Theme.X}) and recolours the brush Theme.X that code-behind uses.
     The other theme has its own copy of this file with the same keys — editing this one
     cannot change a pixel of the other theme. A key missing here keeps the other theme's
     colour after a switch (Theme.Apply logs it), so add a new key to BOTH files. -->
<!-- Light values follow the WPF-UI / WinUI Light standard (base #F3F3F3, card #FBFBFB,
     flyout #FCFCFC, text #E4/#9E/#72/#5C000000 over the base, smoke #4D000000); tokens that
     share a colour in the dark theme share one here too. Accent: the same blue. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Which library theme (WPF-UI ThemesDictionary) goes with this palette. -->
    <sys:String x:Key="Theme.LibraryTheme">Light</sys:String>

    <!-- ===== Surfaces ===== -->
    <SolidColorBrush x:Key="Theme.WindowBg" Color="#FFF3F3F3" />
    <SolidColorBrush x:Key="Theme.CardBg" Color="#FFFBFBFB" />
    <SolidColorBrush x:Key="Theme.CardBgHover" Color="#FFF5F5F5" />
    <SolidColorBrush x:Key="Theme.CardBorder" Color="#FFE0E0E0" />
    <SolidColorBrush x:Key="Theme.CardBorderHover" Color="#FF5E82C4" />

    <!-- ===== The one accent ===== -->
    <Color x:Key="Theme.AccentColor">#FF5E82C4</Color>
    <SolidColorBrush x:Key="Theme.Accent" Color="#FF5E82C4" />
    <SolidColorBrush x:Key="Theme.AccentSoft" Color="#FFDCE4F3" />
    <SolidColorBrush x:Key="Theme.AccentSoftHover" Color="#FFCCD8EE" />

    <!-- ===== Tables (DataGrid, the code-drawn tables, the implicit ListView style) ===== -->
    <SolidColorBrush x:Key="Theme.ListBg" Color="#FFF7F7F7" />
    <SolidColorBrush x:Key="Theme.SelectionBg" Color="#4D5E82C4" />
    <SolidColorBrush x:Key="Theme.TableHeaderBg" Color="#FFEEEEEE" />
    <SolidColorBrush x:Key="Theme.TableLine" Color="#FFE6E6E6" />
    <SolidColorBrush x:Key="Theme.TableRowAlt" Color="#FFF2F2F2" />
    <SolidColorBrush x:Key="Theme.TableRowHover" Color="#FFEBEBEB" />
    <SolidColorBrush x:Key="Theme.TableRowSelected" Color="#FFDCE4F3" />

    <!-- ===== Buttons: default, primary (library + Accent), «add» (AccentGreen text), danger ===== -->
    <SolidColorBrush x:Key="Theme.DangerBg" Color="#FFF1D3D0" />
    <SolidColorBrush x:Key="Theme.DangerBgHover" Color="#FFEBC2BE" />

    <!-- ===== Tiles ===== -->
    <SolidColorBrush x:Key="Theme.TileBg" Color="#FFFBFBFB" />
    <SolidColorBrush x:Key="Theme.TileBgHover" Color="#FFEEF2F9" />
    <SolidColorBrush x:Key="Theme.TileBorder" Color="#FFE0E0E0" />
    <SolidColorBrush x:Key="Theme.TileBorderHover" Color="#FF5E82C4" />
    <SolidColorBrush x:Key="Theme.TileDisabledBg" Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="Theme.TileDisabledBorder" Color="#FFE8E8E8" />
    <SolidColorBrush x:Key="Theme.ChipBg" Color="#09000000" />
    <SolidColorBrush x:Key="Theme.ChipBorder" Color="#17000000" />
    <SolidColorBrush x:Key="Theme.ChipBgHover" Color="#2E5E82C4" />
    <SolidColorBrush x:Key="Theme.PlateGreenBg" Color="#1A3F7A50" />
    <SolidColorBrush x:Key="Theme.PlateGreenBorder" Color="#423F7A50" />
    <SolidColorBrush x:Key="Theme.PlateGreenBgHover" Color="#333F7A50" />
    <SolidColorBrush x:Key="Theme.PlateGreenBorderHover" Color="#803F7A50" />
    <SolidColorBrush x:Key="Theme.PlateAmberBg" Color="#1A8F6A1F" />
    <SolidColorBrush x:Key="Theme.PlateAmberBorder" Color="#4D8F6A1F" />
    <SolidColorBrush x:Key="Theme.PlateAmberBgHover" Color="#338F6A1F" />
    <SolidColorBrush x:Key="Theme.PlateAmberBorderHover" Color="#8C8F6A1F" />
    <SolidColorBrush x:Key="Theme.PlateRedBg" Color="#1AB5473D" />
    <SolidColorBrush x:Key="Theme.PlateRedBorder" Color="#4DB5473D" />
    <SolidColorBrush x:Key="Theme.PlateRedBgHover" Color="#33B5473D" />
    <SolidColorBrush x:Key="Theme.PlateRedBorderHover" Color="#8CB5473D" />
    <SolidColorBrush x:Key="Theme.PlateNeutralBg" Color="#08000000" />
    <SolidColorBrush x:Key="Theme.PlateNeutralBorder" Color="#0F000000" />
    <SolidColorBrush x:Key="Theme.PickerBorder" Color="#FFD4D4D4" />
    <SolidColorBrush x:Key="Theme.PickerRowHover" Color="#0F000000" />
    <SolidColorBrush x:Key="Theme.PickerRowCurrent" Color="#0D000000" />

    <!-- ===== Text ===== -->
    <SolidColorBrush x:Key="Theme.TextPrimary" Color="#FF1A1A1A" />
    <SolidColorBrush x:Key="Theme.TextSecondary" Color="#FF5C5C5C" />
    <SolidColorBrush x:Key="Theme.TextMuted" Color="#FF868686" />
    <SolidColorBrush x:Key="Theme.TextDisabled" Color="#FF9B9B9B" />

    <!-- ===== Accents (tile sub-labels, status text) ===== -->
    <SolidColorBrush x:Key="Theme.AccentGreen" Color="#FF3F7A50" />
    <SolidColorBrush x:Key="Theme.AccentRed" Color="#FFB5473D" />
    <SolidColorBrush x:Key="Theme.ConflictIcon" Color="#FFC97D75" />
    <SolidColorBrush x:Key="Theme.AccentAmber" Color="#FF8F6A1F" />
    <SolidColorBrush x:Key="Theme.NoticeAmber" Color="#FF8F6A1F" />
    <SolidColorBrush x:Key="Theme.NoticeTileBorder" Color="#8C8F6A1F" />
    <SolidColorBrush x:Key="Theme.AccentBlue" Color="#FF3F5F99" />
    <SolidColorBrush x:Key="Theme.AccentGrey" Color="#FF6B717B" />
    <SolidColorBrush x:Key="Theme.SpeedRed" Color="#FFD13438" />
    <SolidColorBrush x:Key="Theme.SpeedAmber" Color="#FFC07A00" />
    <SolidColorBrush x:Key="Theme.SpeedGreen" Color="#FF1E9E4A" />
    <SolidColorBrush x:Key="Theme.SpeedBlue" Color="#FF0F6CBD" />
    <SolidColorBrush x:Key="Theme.SpeedTrack" Color="#FFDADADA" />
    <SolidColorBrush x:Key="Theme.ChipIconBright" Color="#FF333333" />
    <SolidColorBrush x:Key="Theme.NicWifiOk" Color="#FF2F64D6" />
    <SolidColorBrush x:Key="Theme.NicWiredOk" Color="#FF1F9D55" />
    <SolidColorBrush x:Key="Theme.NicTrouble" Color="#FFCA5010" />
    <SolidColorBrush x:Key="Theme.NicOff" Color="#FF9A94AE" />
    <SolidColorBrush x:Key="Theme.GuardBorder" Color="#997C5CD6" />
    <Color x:Key="Theme.GuardSwitchFill">#997C5CD6</Color>
    <Color x:Key="Theme.GuardSwitchFillHover">#BF7C5CD6</Color>

    <!-- ===== Banner: info (idle) — calm slate-blue ===== -->
    <SolidColorBrush x:Key="Theme.BannerInfoBg" Color="#FFEDF2FA" />
    <SolidColorBrush x:Key="Theme.BannerInfoBorder" Color="#FFD3DDEE" />
    <SolidColorBrush x:Key="Theme.BannerInfoText" Color="#FF3F5F99" />

    <!-- ===== Banner: success — subtle, not a wall of green ===== -->
    <SolidColorBrush x:Key="Theme.BannerOkBg" Color="#FFEAF4EC" />
    <SolidColorBrush x:Key="Theme.BannerOkBorder" Color="#FFCDE3D3" />
    <SolidColorBrush x:Key="Theme.BannerOkText" Color="#FF4A7F59" />

    <!-- ===== Banner: warning ===== -->
    <SolidColorBrush x:Key="Theme.BannerWarnBg" Color="#FFFBF3E2" />
    <SolidColorBrush x:Key="Theme.BannerWarnBorder" Color="#FFEBDAB2" />
    <SolidColorBrush x:Key="Theme.BannerWarnText" Color="#FF8F6A1F" />

    <!-- ===== Badge: neutral (VPN not in use) ===== -->
    <SolidColorBrush x:Key="Theme.BadgeNeutralBg" Color="#FFEEEEEE" />
    <SolidColorBrush x:Key="Theme.BadgeNeutralBorder" Color="#FFE0E0E0" />
    <SolidColorBrush x:Key="Theme.BadgeNeutralText" Color="#FF5C5C5C" />

    <!-- ===== Placeholder glyph (no icon) ===== -->
    <SolidColorBrush x:Key="Theme.PlaceholderBg" Color="#FFDCE5F5" />
    <SolidColorBrush x:Key="Theme.PlaceholderText" Color="#FF3A5FA8" />

    <!-- ===== Overlays (in-window dialogs) ===== -->
    <SolidColorBrush x:Key="Theme.OverlayScrim" Color="#FFF3F3F3" />
    <SolidColorBrush x:Key="Theme.OverlayBackdrop" Color="#4D000000" />
    <SolidColorBrush x:Key="Theme.OverlayCardBg" Color="#FFFCFCFC" />
    <SolidColorBrush x:Key="Theme.OverlayBody" Color="#FF3D3D3D" />

    <!-- ===== Shadow ===== -->
    <Color x:Key="Theme.ShadowColor">#33000000</Color>
    <Color x:Key="Theme.ShadowBase">#FF000000</Color>

    <!-- ===== Text on coloured fills ===== -->
    <SolidColorBrush x:Key="Theme.TextOnAction" Color="#FF1F3864" />
    <SolidColorBrush x:Key="Theme.TextOnColor" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Theme.TabCloseGlyph" Color="#FF1A1A1A" />

    <!-- ===== Main window: the action row (named 2026-11-22; values as they were) ===== -->
    <SolidColorBrush x:Key="Theme.ActionDangerHover" Color="#FFF4D9D6" />
    <SolidColorBrush x:Key="Theme.SafeModeBg" Color="#FFDCE4F3" />
    <SolidColorBrush x:Key="Theme.SafeModeCountdown" Color="#FF1F3864" />
    <SolidColorBrush x:Key="Theme.SafeModeLabel" Color="#FF1F3864" />
    <Color x:Key="Theme.SafeModeSwitchFill">#99B5473D</Color>
    <Color x:Key="Theme.SafeModeSwitchFillHover">#BFB5473D</Color>
    <SolidColorBrush x:Key="Theme.EngineBtnBg" Color="#FFF3E3BF" />
    <SolidColorBrush x:Key="Theme.EngineBtnHover" Color="#FFEDD7A6" />
    <SolidColorBrush x:Key="Theme.EngineBtnText" Color="#FF5E4513" />
    <SolidColorBrush x:Key="Theme.ChipDangerBgHover" Color="#FFF0C4BF" />
    <SolidColorBrush x:Key="Theme.ChipDangerBorderHover" Color="#FFDB958D" />

    <!-- ===== VPN priority squares (rule editor, routing matrix) ===== -->
    <SolidColorBrush x:Key="Theme.RankOnBg" Color="#FFCFE6D6" />
    <SolidColorBrush x:Key="Theme.RankOnBorder" Color="#FF7FB492" />
    <SolidColorBrush x:Key="Theme.RankOffBorder" Color="#FFA7B0C3" />
    <SolidColorBrush x:Key="Theme.GuardCellBg" Color="#FFDDD5F5" />
    <SolidColorBrush x:Key="Theme.AccentViolet" Color="#FF7C5CD6" />

    <!-- ===== Identity colours: a tile's monogram, a company badge in DNS statistics ===== -->
    <SolidColorBrush x:Key="Theme.BadgeGreyBg" Color="#FF8A8A8A" />

    <!-- ===== Lists drawn on a card (DNS statistics): stripes and rules over CardBg ===== -->
    <SolidColorBrush x:Key="Theme.ListStripeOnCard" Color="#0A000000" />
    <SolidColorBrush x:Key="Theme.ListLineOnCard" Color="#1C000000" />

    <!-- ===== The speed chart ===== -->
    <SolidColorBrush x:Key="Theme.ChartGrid" Color="#12000000" />
    <SolidColorBrush x:Key="Theme.ChartZeroLine" Color="#38000000" />
    <SolidColorBrush x:Key="Theme.ChartGuide" Color="#46000000" />
    <Color x:Key="Theme.ChartUpColor">#FF6B6E7A</Color>

    <!-- ===== Identity colours: a tile's monogram, a company badge (white text on them) ===== -->
    <Color x:Key="Theme.Monogram0">#FF3F6FD8</Color>
    <Color x:Key="Theme.Monogram1">#FF2F9A6B</Color>
    <Color x:Key="Theme.Monogram2">#FFC26A2E</Color>
    <Color x:Key="Theme.Monogram3">#FF875CCF</Color>
    <Color x:Key="Theme.Monogram4">#FFC04B5C</Color>
    <Color x:Key="Theme.Monogram5">#FF2A8EA8</Color>
    <Color x:Key="Theme.Monogram6">#FF9C7C2C</Color>
    <Color x:Key="Theme.Monogram7">#FF5E6B84</Color>

    <!-- ===== The library inside the palette =====
         WPF-UI draws cards, popups, menus, tooltips and the window with its own greys (partly
         semi-transparent). These keys of its control templates take this palette's tokens. -->
    <!-- Window. WindowFace = what a window's background actually shows. The library paints every
         window with its own colour when it is shown and on every theme switch, over the window's
         Background; Theme.ApplyFrame then puts WindowFace back. The standard base #F3F3F3
         (= WindowBg), not the library's #FAFAFA, under which the #FBFBFB cards would vanish. -->
    <SolidColorBrush x:Key="Theme.WindowFace" Color="#FFF3F3F3" />
    <SolidColorBrush x:Key="WindowBackground" Color="#FFF3F3F3" />
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#FFF3F3F3" />
    <!-- ui:Card / CardExpander: a raised surface with the outline -->
    <SolidColorBrush x:Key="CardBackground" Color="#FFFBFBFB" />
    <SolidColorBrush x:Key="CardBackgroundPointerOver" Color="#FFF5F5F5" />
    <SolidColorBrush x:Key="CardBackgroundPressed" Color="#FFFBFBFB" />
    <SolidColorBrush x:Key="CardBackgroundDisabled" Color="#FFFBFBFB" />
    <SolidColorBrush x:Key="CardFooterBackground" Color="#FFFBFBFB" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#FFE0E0E0" />
    <SolidColorBrush x:Key="CardBorderBrushPressed" Color="#FFE0E0E0" />
    <SolidColorBrush x:Key="CardBorderBrushDisabled" Color="#FFE0E0E0" />
    <!-- Floating: context menus, sub-menus, tooltips, dropdowns, dialogs, snackbars -->
    <SolidColorBrush x:Key="ContextMenuBackground" Color="#FFFCFCFC" />
    <SolidColorBrush x:Key="ContextMenuBorderBrush" Color="#FFD4D4D4" />
    <SolidColorBrush x:Key="FlyoutBackground" Color="#FFFCFCFC" />
    <SolidColorBrush x:Key="FlyoutBorderBrush" Color="#FFD4D4D4" />
    <SolidColorBrush x:Key="ToolTipBackground" Color="#FFFCFCFC" />
    <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#FFD4D4D4" />
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FFFCFCFC" />
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#FFD4D4D4" />
    <SolidColorBrush x:Key="ContentDialogBackground" Color="#FFFCFCFC" />
    <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="#FFD4D4D4" />
    <SolidColorBrush x:Key="SnackBarBackground" Color="#FFFCFCFC" />
    <SolidColorBrush x:Key="SnackBarBorderBrush" Color="#FFD4D4D4" />
    <!-- Opaque greys inside controls -->
    <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="#FFFCFCFC" />
    <SolidColorBrush x:Key="SliderOuterThumbBackground" Color="#FFD4D4D4" />
    <!-- Primary text: the app's, not the library's -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FF1A1A1A" />
</ResourceDictionary>
