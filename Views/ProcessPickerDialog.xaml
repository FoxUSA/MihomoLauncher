<ui:FluentWindow x:Class="MihomoLauncher.Views.ProcessPickerDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{DynamicResource Dlg_RunningPrograms}"
                 Width="720" Height="560"
                 MinWidth="560" MinHeight="400"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="CanResize"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" x:Name="Bar" Title="{DynamicResource Dlg_RunningPrograms}" />

        <Grid Grid.Row="1" Margin="20,8,20,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox x:Name="TxtSearch" Grid.Column="0" PlaceholderText="{DynamicResource Dlg_SearchByNameOrPath}"
                        FontSize="13" TextChanged="OnSearchChanged" />
            <CheckBox x:Name="ChkWindowedOnly" Grid.Column="1" Content="{DynamicResource Dlg_WindowedOnly}"
                      IsChecked="True" VerticalAlignment="Center" Margin="12,0,0,0"
                      Checked="OnFilterToggled" Unchecked="OnFilterToggled" />
            <ui:Button x:Name="BtnReload" Grid.Column="2" Content="{DynamicResource Dlg_Refresh}" Margin="8,0,0,0" Click="OnReload" />
        </Grid>

        <ListView x:Name="LstProcs"
                  Grid.Row="2"
                  Margin="20,0,20,0"
                  SelectionMode="Single"
                  MouseDoubleClick="OnPick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="{DynamicResource Dlg_ColProgram}" Width="240" DisplayMemberBinding="{Binding Display}" />
                    <GridViewColumn Header="{DynamicResource Dlg_ColProcess}" Width="150" DisplayMemberBinding="{Binding ProcessName}" />
                    <GridViewColumn Header="{DynamicResource Dlg_ColPath}" Width="280" DisplayMemberBinding="{Binding Path}" />
                </GridView>
            </ListView.View>
        </ListView>

        <Border Grid.Row="3" Padding="20,12">
            <DockPanel>
                <TextBlock x:Name="LblHint" DockPanel.Dock="Left" VerticalAlignment="Center"
                           FontSize="12" Opacity="0.6"
                           Text="{DynamicResource Dlg_ProcessPickHint}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button x:Name="BtnPick" Content="{DynamicResource Dlg_Select}" Margin="0,0,8,0"
                               Appearance="Primary" FontSize="14" Padding="20,8" Click="OnPick" />
                    <ui:Button Content="{DynamicResource Dlg_Cancel}" FontSize="14" Padding="20,8" Click="OnCancel" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
