<ui:FluentWindow x:Class="MihomoLauncher.Views.ConfigViewerDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="config.yaml"
                 Width="780" Height="660"
                 MinWidth="520" MinHeight="400"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="CanResize"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" x:Name="Bar" Title="config.yaml" />

        <TextBlock Grid.Row="1" x:Name="LblPath" Margin="20,4,20,8"
                   FontSize="12" Opacity="0.7" TextWrapping="Wrap" Text="" />

        <Border Grid.Row="2" Margin="20,0,20,0"
                CornerRadius="6"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1">
            <TextBox x:Name="TxtConfig"
                     IsReadOnly="True"
                     Background="Transparent"
                     BorderThickness="0"
                     FontFamily="Consolas"
                     FontSize="12.5"
                     Padding="10,8"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap"
                     AcceptsReturn="True" />
        </Border>

        <Border Grid.Row="3" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="BtnCopy" Content="{DynamicResource Dlg_Copy}" Margin="0,0,8,0" Click="OnCopy" />
                <ui:Button Content="{DynamicResource Dlg_Close}" Appearance="Primary" Padding="20,8" Click="OnClose" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
