<ui:FluentWindow x:Class="MihomoLauncher.Views.LinkTemplatePickerDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:svc="clr-namespace:MihomoLauncher.Services"
                 Title="{DynamicResource Dlg_TemplatesClashTitle}"
                 Width="680" Height="740"
                 MinWidth="540" MinHeight="480"
                 ResizeMode="CanResize"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" x:Name="Bar" Title="{DynamicResource Dlg_TemplatesClashTitle}" />

        <TextBlock Grid.Row="1" Margin="20,4,20,8" FontSize="12" TextWrapping="Wrap"
                   Foreground="{x:Static svc:Theme.TextSecondary}">
            <Run Text="{DynamicResource Dlg_TemplatesHint}" />
        </TextBlock>

        <!-- One box for everything: words go to titles, descriptions, tags and the index's
             category words; a domain, URL or IP goes to api.byfox.dev's reverse index. -->
        <ui:TextBox Grid.Row="2" x:Name="TxtSearch" Margin="20,0,20,6" FontSize="13"
                    PlaceholderText="{DynamicResource Tpl_SearchHint}"
                    TextChanged="OnSearchChanged">
            <ui:TextBox.Icon>
                <ui:SymbolIcon Symbol="Search24" />
            </ui:TextBox.Icon>
        </ui:TextBox>

        <TextBlock Grid.Row="3" x:Name="LblFind" Margin="22,0,20,8" FontSize="12" TextWrapping="Wrap"
                   Foreground="{x:Static svc:Theme.TextSecondary}" Visibility="Collapsed" />

        <!-- Virtualized list: only the visible cards materialize, so the ~700-template catalog
             opens instantly. -->
        <ListBox Grid.Row="4" x:Name="ItemsHost" Margin="20,0,14,0"
                 Background="Transparent" BorderThickness="0" Padding="0,0,6,0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <!-- The card picks the template; «?» opens what it covers. -->
                    <Border Margin="0,0,0,6" Padding="12,8,6,8" CornerRadius="8" BorderThickness="1"
                            Cursor="Hand" Tag="{Binding}" MouseLeftButtonUp="OnRowClick">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{x:Static svc:Theme.CardBg}" />
                                <Setter Property="BorderBrush" Value="{x:Static svc:Theme.CardBorder}" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{x:Static svc:Theme.CardBgHover}" />
                                        <Setter Property="BorderBrush" Value="{x:Static svc:Theme.CardBorderHover}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <DockPanel LastChildFill="True">
                                    <Border DockPanel.Dock="Right" Margin="8,0,0,0" Padding="7,1" CornerRadius="4"
                                            VerticalAlignment="Center"
                                            Background="{x:Static svc:Theme.BadgeNeutralBg}"
                                            Visibility="{Binding CategoryVisibility}">
                                        <TextBlock Text="{Binding CategoryText}" FontSize="11"
                                                   Foreground="{x:Static svc:Theme.BadgeNeutralText}" />
                                    </Border>
                                    <TextBlock TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                        <Run Text="{Binding Title, Mode=OneWay}" FontSize="14" FontWeight="SemiBold"
                                             Foreground="{x:Static svc:Theme.TextPrimary}" />
                                        <Run Text="{Binding NameNote, Mode=OneWay}" FontSize="12"
                                             Foreground="{x:Static svc:Theme.TextMuted}" />
                                    </TextBlock>
                                </DockPanel>
                                <TextBlock Text="{Binding Desc}" FontSize="12" Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{x:Static svc:Theme.TextSecondary}" />
                                <TextBlock Text="{Binding HitText}" FontSize="11" Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{x:Static svc:Theme.AccentAmber}"
                                           Visibility="{Binding HitVisibility}" />
                            </StackPanel>
                            <ui:Button Grid.Column="1" Appearance="Transparent" Margin="6,0,0,0" Padding="8"
                                       VerticalAlignment="Center" Tag="{Binding}" Click="OnInfo"
                                       ToolTip="{DynamicResource Tpl_InfoTip}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="QuestionCircle24" FontSize="20" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="5" Margin="20,10,20,12">
            <TextBlock x:Name="LblCount" VerticalAlignment="Center" FontSize="12"
                       Foreground="{x:Static svc:Theme.TextMuted}" />
            <ui:Button Content="{DynamicResource Dlg_Close}" HorizontalAlignment="Right" FontSize="14" Padding="20,8" Click="OnCancel" />
        </Grid>
    </Grid>
</ui:FluentWindow>
