<ui:FluentWindow x:Class="MihomoLauncher.Views.SpeedWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:svc="clr-namespace:MihomoLauncher.Services"
                 Width="960"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 Background="{DynamicResource Theme.WindowFace}">
    <!-- A tile's speed (2026-11-16): its own window, not an overlay — it can be dragged off the
         launcher. The body is built by MainWindow.ShowSpeedHistory. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" x:Name="Bar" ShowMaximize="False" ShowMinimize="False" />

        <ContentControl Grid.Row="1" x:Name="Body" Margin="20,4,20,8" />
    </Grid>
</ui:FluentWindow>
