<ui:FluentWindow x:Class="MihomoLauncher.Views.EditSlotDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{DynamicResource Slot_Title}"
                 Width="640"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" x:Name="Bar" Title="{DynamicResource Slot_Title}" />

        <StackPanel Grid.Row="1" Margin="20,8,20,8">
                <!-- The link comes first: the type and the name are worked out from it. -->
                <TextBlock Text="{DynamicResource Slot_Source}" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,4" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox x:Name="TxtValue" Grid.Column="0" FontSize="13"
                                AcceptsReturn="True" TextWrapping="NoWrap" MaxHeight="120"
                                VerticalScrollBarVisibility="Auto"
                                TextChanged="OnValueChanged" />
                    <ui:Button x:Name="BtnBrowse" Grid.Column="1" Content="{DynamicResource Slot_Browse}" Margin="8,0,0,0"
                               VerticalAlignment="Top" Click="OnBrowse" />
                </Grid>
                <TextBlock x:Name="LblDetected" FontSize="12.5" FontWeight="SemiBold" Margin="0,6,0,0"
                           TextWrapping="Wrap" Visibility="Collapsed" />
                <TextBlock x:Name="HintValue"
                           Text="{DynamicResource Slot_HintAny}"
                           FontSize="11" Opacity="0.6" Margin="0,4,0,0" TextWrapping="Wrap" />

                <StackPanel x:Name="PnlName">
                    <TextBlock Text="{DynamicResource Slot_Name}" FontSize="13" FontWeight="SemiBold" Margin="0,16,0,4" />
                    <ui:TextBox x:Name="TxtName" FontSize="13" />
                </StackPanel>

                <!-- Subscription refresh interval — only shown for Clash/mihomo подписка. -->
                <StackPanel x:Name="PnlInterval" Visibility="Collapsed">
                    <TextBlock Text="{DynamicResource Slot_RefreshRate}" FontSize="13" FontWeight="SemiBold" Margin="0,16,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="TxtInterval" Grid.Column="0" FontSize="13" Width="120" HorizontalAlignment="Left" />
                        <!-- Only for a saved subscription whose link is unchanged: the window shows
                             (and downloads) exactly what's stored. -->
                        <StackPanel x:Name="PnlSubButtons" Grid.Column="2" Orientation="Horizontal" Visibility="Collapsed">
                            <ui:Button Content="{DynamicResource Set_BtnRefresh}" MinWidth="92" Margin="0,0,8,0" Click="OnRefreshSub" />
                            <ui:Button Content="{DynamicResource Set_BtnSubContents}" MinWidth="92" Click="OnSubContents" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{DynamicResource Slot_RefreshHint}"
                               FontSize="11" Opacity="0.6" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <CheckBox x:Name="ChkEnabled"
                          Content="{DynamicResource Slot_UseInRotation}"
                          FontSize="13"
                          Margin="0,20,0,0" />
        </StackPanel>

        <Border Grid.Row="2" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="{DynamicResource Slot_Save}" Margin="0,0,8,0"
                           Appearance="Primary" FontSize="14" Padding="20,8"
                           Click="OnSave" />
                <ui:Button Content="{DynamicResource Slot_Cancel}" FontSize="14" Padding="20,8" Click="OnCancel" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
