<ui:FluentWindow x:Class="MihomoLauncher.Views.UninstallWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:svc="clr-namespace:MihomoLauncher.Services"
                 Title="{DynamicResource Uni_Title}"
                 Width="540"
                 SizeToContent="Height"
                 WindowStartupLocation="CenterScreen"
                 ResizeMode="NoResize"
                 ShowInTaskbar="True"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 Background="{DynamicResource Theme.WindowFace}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" x:Name="Bar" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="24,0,24,20">
            <TextBlock Text="{DynamicResource Uni_Title}"
                       FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource Theme.TextPrimary}" />

            <TextBlock Margin="0,8,0,0" FontSize="13" TextWrapping="Wrap"
                       Foreground="{DynamicResource Theme.TextSecondary}"
                       Text="{DynamicResource Uni_Intro}" />

            <Border Margin="0,12,0,0"
                    Background="{DynamicResource Theme.ListBg}"
                    BorderBrush="{DynamicResource Theme.CardBorder}"
                    BorderThickness="1" CornerRadius="8">
                <ItemsControl x:Name="StepsList" Margin="10,6">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Glyph}"
                                           FontSize="14" FontWeight="Bold"
                                           Foreground="{Binding GlyphBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Title}"
                                           FontSize="13" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Theme.TextPrimary}" />
                                <TextBlock Grid.Column="2" Text="{Binding Detail}"
                                           FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"
                                           TextAlignment="Right" TextWrapping="Wrap"
                                           Foreground="{Binding DetailBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <TextBlock Margin="0,12,0,2" FontSize="13"
                       Foreground="{DynamicResource Theme.TextSecondary}"
                       Text="{DynamicResource Uni_FolderNote}" />
            <TextBox x:Name="TxtFolder" IsReadOnly="True" FontSize="12.5" TextWrapping="Wrap" />

            <ProgressBar x:Name="Bar2" Margin="0,14,0,0"
                         Height="6" Minimum="0" Maximum="100" Value="0"
                         Visibility="Collapsed"
                         Foreground="{DynamicResource Theme.Accent}"
                         Background="{DynamicResource Theme.ListBg}"
                         BorderThickness="0" />

            <Border x:Name="DonePanel" Visibility="Collapsed"
                    Margin="0,14,0,0" Padding="12,10"
                    Background="{DynamicResource Theme.BannerOkBg}"
                    BorderBrush="{DynamicResource Theme.BannerOkBorder}"
                    BorderThickness="1" CornerRadius="6">
                <TextBlock TextWrapping="Wrap" FontSize="13"
                           Foreground="{DynamicResource Theme.BannerOkText}"
                           Text="{DynamicResource Uni_DoneBanner}" />
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <ui:Button x:Name="BtnRun" Content="{DynamicResource Uni_BtnRun}" MinWidth="110"
                           FontSize="14" Padding="20,8" IsEnabled="False" Click="OnRun" />
                <ui:Button x:Name="BtnClose" Content="{DynamicResource Uni_BtnClose}" MinWidth="110"
                           FontSize="14" Padding="20,8" Margin="8,0,0,0" Click="OnClose" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
