<ui:FluentWindow x:Class="MihomoLauncher.Views.EditRuleDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:svc="clr-namespace:MihomoLauncher.Services"
                 xmlns:views="clr-namespace:MihomoLauncher.Views"
                 Title="{DynamicResource Rule_Title}"
                 Width="780" Height="640"
                 MinWidth="660" MinHeight="520"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="CanResizeWithGrip"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 Background="{DynamicResource Theme.WindowFace}">
    <Grid Background="Transparent" MouseDown="OnBackgroundClick">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Compact window (2026-11-22): every pixel taken from the rows below goes to the list (row 3 is *). -->
        <ui:TitleBar Grid.Row="0" x:Name="Bar" Title="{DynamicResource Rule_Title}" Height="32" />

        <!-- ===== Row 1: name + check url ===== -->
        <Grid x:Name="RowName" Grid.Row="1" Margin="20,2,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:TextBox x:Name="TxtName" Grid.Column="0" FontSize="13" MaxLength="40"
                        MinHeight="0" Height="30" Padding="8,3" VerticalContentAlignment="Center"
                        PlaceholderText="{DynamicResource Rule_NamePlaceholder}" />
            <!-- «Не проверять» is gone (2026-11-23): the address IS the switch — filled = checked,
                 empty = not checked; the field takes the box's place. Never filled by itself. -->
            <ui:TextBox x:Name="TxtCheckUrl" Grid.Column="1" FontSize="13" Margin="8,0,0,0"
                        MinHeight="0" Height="30" Padding="8,3" VerticalContentAlignment="Center"
                        svc:PasteButton.IsEnabled="True"
                        ToolTip="{DynamicResource Rule_CheckUrlTip}"
                        PlaceholderText="{DynamicResource Rule_CheckUrlPlaceholder}" />
        </Grid>

        <!-- ===== Row 2: icon row (Обзор + path, one line) + table title ===== -->
        <StackPanel x:Name="RowIcon" Grid.Row="2" Margin="20,5,20,0">
            <!-- «Иконка с сервера» is gone (2026-11-23): an empty path = the server's icon, a path =
                 the person's own. Both always enabled; the switch's room went to the path. -->
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:Button Grid.Column="0" Content="{DynamicResource Rule_Browse}" Click="OnBrowseIcon"
                           MinHeight="0" Height="30" Padding="11,3" />
                <ui:TextBox x:Name="TxtIcon" Grid.Column="1" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"
                            MinHeight="0" Height="30" Padding="8,3" VerticalContentAlignment="Center"
                            ToolTip="{DynamicResource Rule_IconPathTip}"
                            PlaceholderText="{DynamicResource Rule_IconPathPlaceholder}" />
            </Grid>

            <TextBlock Text="{DynamicResource Rule_WhatIncluded}" FontSize="13" FontWeight="SemiBold" Margin="0,7,0,3" />
        </StackPanel>

        <!-- ===== Row 3: the table — framed, fills the rest, visible even when empty ===== -->
        <Border x:Name="RowItems" Grid.Row="3" Margin="20,0,20,0" CornerRadius="8"
                Background="{DynamicResource Theme.ListBg}"
                BorderBrush="{DynamicResource Theme.CardBorder}" BorderThickness="1">
            <!-- One outline, not two (2026-11-22: «двоится»): the shared styles close the table with
                 their own left / top / right lines, and the frame drew a second one a pixel away.
                 The grid is pushed 1 px out on those three sides and clipped back to the frame's
                 rounded inside (svc:FrameClip), so the table's outer lines are cut off and the
                 frame is the only outline. -->
            <Grid>
                <!-- Looks like the rules list (ListsWindow.GridApps, 2026-11-22): the shared styles as they
                     are — 26 px rows, 34 px header; the controls inside a row are sized to fit 26. -->
                <DataGrid x:Name="ItemsGrid" Margin="-1,-1,-1,0" svc:FrameClip.Radius="7" Background="Transparent"
                          Style="{StaticResource AppDataGridStyle}"
                          CellStyle="{StaticResource AppDataGridCellStyle}"
                          ColumnHeaderStyle="{StaticResource AppColumnHeaderStyle}">
                    <!-- A row auto-tracking added and nobody has seen yet (RuleProgram.AutoNew): one
                         amber 1 px frame around the whole row, all four sides (the top too — asked
                         for after seeing it without). Shown once: the flag is cleared when the editor
                         closes. Nothing else about the row changes. -->
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource AppDataGridRowStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAutoNew}" Value="True">
                                    <!-- Exactly the tile's notice frame: same brush, same 1 px. -->
                                    <Setter Property="BorderBrush" Value="{DynamicResource Theme.NoticeTileBorder}" />
                                    <!-- 2 px at the sides: the outer one is under the frame's clip. -->
                                    <Setter Property="BorderThickness" Value="2,1,2,1" />
                                </DataTrigger>
                                <!-- Third section «Не добавлять автоматически»: muted. -->
                                <DataTrigger Binding="{Binding IsIgnored}" Value="True">
                                    <Setter Property="Opacity" Value="0.5" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <!-- Two sections (2026-11-22): what the person added, then — only when there is
                         any — a thin captioned line and what auto-tracking added. Grouped by
                         ItemRow.Section ("manual" / "auto"); the manual group has no header. -->
                    <DataGrid.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="GroupItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="GroupItem">
                                                <StackPanel>
                                                    <!-- Between the two sections: line — caption — line, in a colour
                                                         that reads on the dark grid (2026-11-22: «не видно»). -->
                                                    <Grid x:Name="AutoHeader" Margin="10,5,10,3" Visibility="Collapsed">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Height="1" VerticalAlignment="Center"
                                                                Background="{DynamicResource Theme.AccentBlue}" Opacity="0.45" />
                                                        <TextBlock x:Name="AutoCaption" Grid.Column="1" Text="{DynamicResource Rule_AutoSection}" FontSize="12.5"
                                                                   FontWeight="SemiBold" Foreground="{DynamicResource Theme.AccentBlue}"
                                                                   VerticalAlignment="Center" Margin="12,0" />
                                                        <Border Grid.Column="2" Height="1" VerticalAlignment="Center"
                                                                Background="{DynamicResource Theme.AccentBlue}" Opacity="0.45" />
                                                    </Grid>
                                                    <!-- Cells draw only their right and bottom edges (AppDataGridCellStyle),
                                                         so the first auto row needs its top line here — like the upper
                                                         table gets from its header. -->
                                                    <Border x:Name="AutoTopLine" Height="1" Visibility="Collapsed"
                                                            Background="{DynamicResource Theme.TableLine}" />
                                                    <ItemsPresenter />
                                                </StackPanel>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Name}" Value="auto">
                                                        <Setter TargetName="AutoHeader" Property="Visibility" Value="Visible" />
                                                        <Setter TargetName="AutoTopLine" Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <!-- The third section: what this rule refuses to auto-add. -->
                                                    <DataTrigger Binding="{Binding Name}" Value="ignored">
                                                        <Setter TargetName="AutoHeader" Property="Visibility" Value="Visible" />
                                                        <Setter TargetName="AutoTopLine" Property="Visibility" Value="Visible" />
                                                        <Setter TargetName="AutoCaption" Property="Text" Value="{DynamicResource Rule_IgnoredSection}" />
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </DataGrid.GroupStyle>
                    <DataGrid.Columns>
                        <!-- Плитка: single-select checkbox (what launches from the tile) -->
                        <!-- Minimum widths (2026-11-23): with no rows an Auto column sizes to its caption
                             only and the header looked squeezed; these are about what the rows give. -->
                        <DataGridTemplateColumn Header="{DynamicResource Rule_ColTile}" Width="Auto" MinWidth="64" CanUserSort="False" CanUserResize="False"
                                                CellStyle="{StaticResource CheckboxCellStyle}"
                                                HeaderStyle="{StaticResource CheckboxColumnHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <!-- No box on a template: a domain list has nothing to open. -->
                                    <CheckBox Style="{StaticResource DataGridCheckBoxStyle}" Cursor="Hand"
                                              Visibility="{Binding LaunchVisibility}"
                                              IsChecked="{Binding Launch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="{DynamicResource Rule_TileTip}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Тип: clickable — opens site / template path / reveals file in Explorer.
                             Cursor changes to Hand; no cell highlight (handled on preview-down). -->
                        <DataGridTemplateColumn Header="{DynamicResource Rule_ColType}" Width="Auto" MinWidth="96" CanUserSort="False" CanUserResize="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TypeLabel}" Cursor="Hand" Padding="2,0"
                                               VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                               Background="Transparent"
                                               PreviewMouseLeftButtonDown="OnTypeClick"
                                               ToolTip="{DynamicResource Rule_TypeTip}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Имя: template name / site host / exe file / Store app name -->
                        <DataGridTemplateColumn Header="{DynamicResource Rule_ColName}" Width="Auto" MinWidth="130" MaxWidth="240" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" FontSize="12" Padding="2,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Cursor="Hand" Background="Transparent"
                                               PreviewMouseLeftButtonDown="OnTypeClick"
                                               ToolTip="{Binding NameTip}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Что открывается / запускается: editable URL for sites, path for programs -->
                        <DataGridTemplateColumn Header="{DynamicResource Rule_ColWhatOpens}" Width="*" MinWidth="220" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <!-- Click anywhere on the path = open it (same as «Тип»): a template
                                         opens its list, a program is shown in Explorer. A plain site's
                                         box is for typing, so it gets a small ↗ to open it instead. -->
                                    <Grid>
                                        <!-- plain site: editable URL + open -->
                                        <Grid Visibility="{Binding SiteVisibility}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <!-- Fits the 26 px row: WPF-UI's box is 32+ px tall by default. -->
                                            <ui:TextBox FontSize="12" MinHeight="0" Height="22" Padding="6,1"
                                                        VerticalContentAlignment="Center"
                                                        svc:PasteButton.IsEnabled="True"
                                                        VerticalAlignment="Center" PlaceholderText="example.com"
                                                        Text="{Binding Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <Border Grid.Column="1" Width="20" Height="20" Margin="4,0,0,0"
                                                    CornerRadius="5" Background="Transparent" Cursor="Hand"
                                                    VerticalAlignment="Center"
                                                    PreviewMouseLeftButtonDown="OnTypeClick"
                                                    ToolTip="{DynamicResource Rule_TypeTip}">
                                                <ui:SymbolIcon Symbol="Open24" FontSize="13"
                                                               Foreground="{DynamicResource Theme.Accent}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                        <!-- template: read-only path to the rule list -->
                                        <TextBlock Visibility="{Binding TemplatePathVisibility}" Text="{Binding ClashRuleUrl}"
                                                   FontSize="12" VerticalAlignment="Center"
                                                   Cursor="Hand" Background="Transparent"
                                                   PreviewMouseLeftButtonDown="OnTypeClick"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding TemplateLabel}" />
                                        <!-- program / store: name + path -->
                                        <TextBlock Visibility="{Binding ProgVisibility}" Text="{Binding ProgOneLine}"
                                                   FontSize="12" VerticalAlignment="Center"
                                                   Cursor="Hand" Background="Transparent"
                                                   PreviewMouseLeftButtonDown="OnTypeClick"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding PathTip}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Remove -->
                        <DataGridTemplateColumn Width="42" CanUserSort="False" CanUserResize="False"
                                                CellStyle="{StaticResource CheckboxCellStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ui:Button Content="✕" Padding="6,0" FontSize="12" MinHeight="0" Height="20"
                                               Background="Transparent" BorderThickness="0" Cursor="Hand"
                                               Foreground="{DynamicResource Theme.AccentRed}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Click="OnRemoveItem" ToolTip="{DynamicResource Rule_Remove}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="LblItemsEmpty"
                           Text="{DynamicResource Rule_Empty}"
                           FontSize="12" Opacity="0.5" IsHitTestVisible="False"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- ===== Row 4: add buttons (right under the table) ===== -->
        <StackPanel x:Name="RowAddButtons" Grid.Row="4" Orientation="Horizontal" Margin="20,5,20,0">
            <ui:Button Content="URL" MinWidth="70" MinHeight="0" Height="28" Padding="10,2" Margin="0,0,8,0" Click="OnAddSiteUrl" />
            <ui:Button Content="{DynamicResource Rule_AddTemplate}" MinWidth="96" MinHeight="0" Height="28" Padding="10,2" Margin="0,0,8,0" Click="OnAddSiteTemplate" />
            <ui:Button x:Name="BtnAddApp" Content="{DynamicResource Rule_AddApp}" MinWidth="96" MinHeight="0" Height="28" Padding="10,2" Margin="0,0,8,0" Click="OnAddProgPath" />
            <ui:Button x:Name="BtnAddProcess" Content="{DynamicResource Rule_AddProcess}" MinWidth="80" MinHeight="0" Height="28" Padding="10,2" Margin="0,0,8,0" Click="OnAddProgRunning" />
            <!-- A whole folder as ONE row (2026-11-22): everything started from it goes this way. -->
            <ui:Button x:Name="BtnAddFolder" Content="{DynamicResource Rule_AddFolder}" MinWidth="70" MinHeight="0" Height="28" Padding="10,2" Margin="0,0,8,0" Click="OnAddFolder"
                       ToolTip="{DynamicResource Rule_AddFolderTip}" />
            <ui:Button x:Name="BtnAddStore" Content="Store" MinWidth="70" MinHeight="0" Height="28" Padding="10,2" Click="OnAddProgStore" />
        </StackPanel>

        <!-- ===== Row 5: VPN switches + allowed variants ===== -->
        <StackPanel x:Name="RowVpn" Grid.Row="5" Margin="20,8,20,0">
            <!-- «Использовать VPN» removed 2026-11-14: VPN or «Напрямую» is picked on the tile's
                 plate, like any other exit; the list below is which VPNs, in what order. -->
            <!-- A WrapPanel (2026-11-22, third switch): with a long card name or a narrow window the
                 last switch moves to a second line instead of being cut off. -->
            <!-- The gaps are on the RIGHT of each switch (2026-11-27): a switch that wraps to the next
                 line starts flush with the first one, not indented by its left gap. -->
            <WrapPanel Orientation="Horizontal">
                <!-- Both switches, when on, are the violet of the tile chips' frame (2026-11-20). -->
                <ui:ToggleSwitch x:Name="ChkKillSwitch" Content="Kill-switch" Margin="0,0,24,10"
                                 Style="{DynamicResource GuardToggleSwitchStyle}" />
                <!-- 2026-11-19: pin the tile to the card it goes through now; the card's name next to it. -->
                <StackPanel Orientation="Horizontal" Margin="0,0,24,10">
                    <ui:ToggleSwitch x:Name="ChkLockNic" Content="{DynamicResource Rule_LockNic}"
                                     ToolTip="{DynamicResource Rule_LockNicTip}"
                                     Checked="OnLockNicChecked" Unchecked="OnLockNicUnchecked"
                                     Style="{DynamicResource GuardToggleSwitchStyle}" />
                    <TextBlock x:Name="TxtLockNic" FontSize="12.5" Opacity="0.6" Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
                <!-- 2026-11-22: helpers of the rule's programs that go online join the rule by
                     themselves (AutoPrograms). Plain accent colour: it guards nothing. -->
                <ui:ToggleSwitch x:Name="ChkAutoTrack" Content="{DynamicResource Rule_AutoTrack}" Margin="0,0,24,10"
                                 ToolTip="{DynamicResource Rule_AutoTrackTip}" IsChecked="True" />
                <!-- 2026-11-27: the ticked VPNs become the hops of one chain (Services.Cascade), up to 3. -->
                <ui:ToggleSwitch x:Name="ChkCascade" Content="{DynamicResource Edit_Cascade}" Margin="0,0,24,10"
                                 ToolTip="{DynamicResource Edit_CascadeTip}"
                                 Checked="OnCascadeChanged" Unchecked="OnCascadeChanged" />
            </WrapPanel>

            <!-- The rows stay in the Settings order; priority is the NUMBER in the box, not the
                 row position, which is what lets the same control work here and in the VPN table
                 (where rows are rules and there is nothing to drag).
                 How the boxes work lives in the caption's tooltip: the two-line hint under it
                 was removed on request (2026-11-22). -->
            <!-- Right after the caption (2026-11-23): one button that numbers every configuration
                 1..N in the order shown («Отметить все») or clears them all («Снять все») — through
                 the same Renumber as a click on a square, so its caption follows those clicks too. -->
            <!-- Margin 0/9: the same place as the cascade chain that replaces it, so nothing moves
                 when the switch flips (2026-11-27). -->
            <StackPanel x:Name="SlotsHeader" Orientation="Horizontal" Margin="0,0,0,9" Height="22">
                <TextBlock x:Name="LblAllowedVpn" Text="{DynamicResource Rule_AllowedVpn}" Background="Transparent"
                           ToolTip="{DynamicResource Rule_VpnOrderHint}" VerticalAlignment="Center"
                           FontSize="12.5" FontWeight="SemiBold" />
                <ui:Button x:Name="BtnAllSlots" Margin="10,0,0,0" MinHeight="0" Height="22" Padding="8,0"
                           FontSize="12" VerticalAlignment="Center" Cursor="Hand"
                           Content="{DynamicResource Rule_SlotsAll}" Click="OnAllSlots" />
                <TextBlock x:Name="LblCascadeHint" Text="{DynamicResource Edit_CascadeHint}" Margin="10,0,0,0"
                           FontSize="12.5" Opacity="0.6" VerticalAlignment="Center" Visibility="Collapsed" />
            </StackPanel>
            <!-- «Каскадный VPN» (2026-11-27): the caption row above gives its place to the chain as
                 it will run — you › 1 › 2 › 3 › the site, with flags — at exactly its height, so the
                 window and the table above don't change size when the switch flips. -->
            <!-- Margin 0/9 instead of the caption's 6/3 (2026-11-27): the same height, sitting higher —
                 off the squares, into the room under the switches. -->
            <StackPanel x:Name="CascadeChainRow" Orientation="Horizontal" Margin="0,0,0,9" Height="22"
                        ClipToBounds="True" Visibility="Collapsed" />
            <!-- Two columns, filled column by column (2026-11-27, was three, row by row): more VPN
                 variants add a row per two instead of one each, so the card doesn't keep growing down. Each row is one
                 line: box · name · the ISO badge and «Город, Страна» (mockup .dev\mockups\rule-vpn-geo.html,
                 variant В). The names share one width (SharedSizeGroup = the longest name), so the
                 badges stand in a straight column right behind them. -->
            <ItemsControl x:Name="AllowSlots" Grid.IsSharedSizeScope="True">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- Column by column: 1 2 3 down the left, 4 5 6 down the right (2026-11-27). -->
                        <views:ColumnFirstGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- The whole row toggles — the box AND the name (2026-11-16). Transparent
                             background so the gaps between them take the click too. -->
                        <Grid Margin="0,3,12,3" Background="Transparent" Cursor="Hand"
                              Tag="{Binding Id}" ToolTip="{Binding BoxTip}" Opacity="{Binding RowOpacity}"
                              MouseLeftButtonUp="OnSlotToggle">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="SlotName" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="20" Height="20" CornerRadius="4"
                                    BorderThickness="1" Margin="0,0,8,0" VerticalAlignment="Center"
                                    Background="{Binding BoxFill}"
                                    BorderBrush="{Binding BoxEdge}">
                                <TextBlock Text="{Binding RankText}" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{Binding RankFore}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <!-- The name goes in a TextBlock, NOT in Content: a ContentPresenter
                                 treats a plain string as an access key, so "Node_1 — DE" loses its
                                 underscore. One line; a name past 180 is cut with «…». -->
                            <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="13" MaxWidth="180"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <Grid Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center"
                                  Visibility="{Binding GeoVisibility}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="26" Height="16" CornerRadius="4" BorderThickness="1" Margin="0,0,5,0"
                                        Background="{DynamicResource Theme.ChipBg}" BorderBrush="{DynamicResource Theme.CardBorder}"
                                        VerticalAlignment="Center" Visibility="{Binding IsoVisibility}">
                                    <TextBlock Text="{Binding Iso}" FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource Theme.TextPrimary}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Place}" FontSize="11.5" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Theme.TextSecondary}"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="LblNoAllowSlots" Text="{DynamicResource Rule_NoVpnVariants}"
                       FontSize="12.5" Opacity="0.6" TextWrapping="Wrap"
                       Visibility="Collapsed" Margin="0,0,0,2" />
        </StackPanel>

        <!-- ===== Row 6: save / cancel ===== -->
        <Border Grid.Row="6" Padding="20,8,20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="BtnSave" Content="{DynamicResource Rule_Save}" Margin="0,0,8,0"
                           Appearance="Primary" FontSize="14" Padding="20,2" MinHeight="0" Height="30" Click="OnSave" />
                <ui:Button Content="{DynamicResource Rule_Cancel}" FontSize="14" Padding="20,2" MinHeight="0" Height="30" Click="OnCancel" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
