<ui:FluentWindow x:Class="MihomoLauncher.Views.EditRuleDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:svc="clr-namespace:MihomoLauncher.Services"
                 Title="{DynamicResource Rule_Title}"
                 Width="780" Height="640"
                 MinWidth="660" MinHeight="520"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="CanResizeWithGrip"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <Grid Background="Transparent" MouseDown="OnBackgroundClick">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" x:Name="Bar" Title="{DynamicResource Rule_Title}" />

        <!-- ===== Row 1: name + check url ===== -->
        <Grid x:Name="RowName" Grid.Row="1" Margin="20,8,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox x:Name="TxtName" Grid.Column="0" FontSize="13" MaxLength="40"
                        PlaceholderText="{DynamicResource Rule_NamePlaceholder}" />
            <ui:TextBox x:Name="TxtCheckUrl" Grid.Column="1" FontSize="13" Margin="8,0,0,0"
                        PlaceholderText="{DynamicResource Rule_CheckUrlPlaceholder}" />
            <!-- Right on the check-address line, because it's what turns that address off. -->
            <CheckBox x:Name="ChkSkipCheck" Grid.Column="2" Margin="10,0,0,0" IsChecked="True"
                      VerticalAlignment="Center" FontSize="13"
                      Content="{DynamicResource Rule_SkipCheck}"
                      ToolTip="{DynamicResource Rule_SkipCheckTip}" />
        </Grid>

        <!-- ===== Row 2: icon row (label + switch + Обзор + path, all in one line) + table title ===== -->
        <StackPanel x:Name="RowIcon" Grid.Row="2" Margin="20,10,20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="LblAutoIcon" Grid.Column="0" Text="{DynamicResource Rule_AutoIcon}" FontSize="13"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <ui:ToggleSwitch x:Name="ChkAutoIcon" Grid.Column="1" VerticalAlignment="Center"
                                 Checked="OnAutoIconToggled" Unchecked="OnAutoIconToggled" />
                <Grid x:Name="IconManualPanel" Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:Button Grid.Column="0" Content="{DynamicResource Rule_Browse}" Click="OnBrowseIcon" />
                    <ui:TextBox x:Name="TxtIcon" Grid.Column="1" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"
                                PlaceholderText="{DynamicResource Rule_IconPathPlaceholder}" />
                </Grid>
            </Grid>

            <TextBlock Text="{DynamicResource Rule_WhatIncluded}" FontSize="13" FontWeight="SemiBold" Margin="0,14,0,4" />
        </StackPanel>

        <!-- ===== Row 3: the table — framed, fills the rest, visible even when empty ===== -->
        <Border x:Name="RowItems" Grid.Row="3" Margin="20,0,20,0" CornerRadius="8"
                Background="{x:Static svc:Theme.ListBg}"
                BorderBrush="{x:Static svc:Theme.TileBorder}" BorderThickness="1">
            <Grid>
                <DataGrid x:Name="ItemsGrid" Margin="1" Background="Transparent"
                          RowHeight="36" VerticalScrollBarVisibility="Auto"
                          Style="{StaticResource AppDataGridStyle}"
                          RowStyle="{StaticResource AppDataGridRowStyle}"
                          CellStyle="{StaticResource AppDataGridCellStyle}"
                          ColumnHeaderStyle="{StaticResource AppColumnHeaderStyle}">
                    <DataGrid.Columns>
                        <!-- Плитка: single-select checkbox (what launches from the tile) -->
                        <DataGridTemplateColumn Header="{DynamicResource Rule_ColTile}" Width="Auto" CanUserSort="False" CanUserResize="False"
                                                CellStyle="{StaticResource CheckboxCellStyle}"
                                                HeaderStyle="{StaticResource CheckboxColumnHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox Style="{StaticResource DataGridCheckBoxStyle}" Cursor="Hand"
                                              IsChecked="{Binding Launch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="{DynamicResource Rule_TileTip}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Тип: clickable — opens site / template path / reveals file in Explorer.
                             Cursor changes to Hand; no cell highlight (handled on preview-down). -->
                        <DataGridTemplateColumn Header="{DynamicResource Rule_ColType}" Width="Auto" CanUserSort="False" CanUserResize="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TypeLabel}" Cursor="Hand" Padding="2,0"
                                               VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                               Background="Transparent"
                                               PreviewMouseLeftButtonDown="OnTypeClick"
                                               ToolTip="{DynamicResource Rule_TypeTip}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Имя: template name / site host / exe file / Store app name -->
                        <DataGridTemplateColumn Header="{DynamicResource Rule_ColName}" Width="Auto" MaxWidth="240" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" FontSize="12.5" Padding="2,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding DisplayName}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Что открывается / запускается: editable URL for sites, path for programs -->
                        <DataGridTemplateColumn Header="{DynamicResource Rule_ColWhatOpens}" Width="*" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <!-- plain site: editable URL -->
                                        <ui:TextBox Visibility="{Binding SiteVisibility}" FontSize="12.5"
                                                    VerticalAlignment="Center" PlaceholderText="example.com"
                                                    Text="{Binding Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <!-- template: read-only path to the rule list -->
                                        <TextBlock Visibility="{Binding TemplatePathVisibility}" Text="{Binding ClashRuleUrl}"
                                                   FontSize="12" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding TemplateLabel}" />
                                        <!-- program / store: name + path -->
                                        <TextBlock Visibility="{Binding ProgVisibility}" Text="{Binding ProgOneLine}"
                                                   FontSize="12" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding ProgTitle}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Remove -->
                        <DataGridTemplateColumn Width="42" CanUserSort="False" CanUserResize="False"
                                                CellStyle="{StaticResource CheckboxCellStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ui:Button Content="✕" Padding="6,0" FontSize="12"
                                               Background="Transparent" BorderThickness="0" Cursor="Hand"
                                               Foreground="{x:Static svc:Theme.AccentRed}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Click="OnRemoveItem" ToolTip="{DynamicResource Rule_Remove}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="LblItemsEmpty"
                           Text="{DynamicResource Rule_Empty}"
                           FontSize="12" Opacity="0.5" IsHitTestVisible="False"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- ===== Row 4: add buttons (right under the table) ===== -->
        <StackPanel x:Name="RowAddButtons" Grid.Row="4" Orientation="Horizontal" Margin="20,8,20,0">
            <ui:Button Content="URL" MinWidth="70" Margin="0,0,8,0" Click="OnAddSiteUrl"
                       Foreground="{x:Static svc:Theme.AccentGreen}" />
            <ui:Button Content="{DynamicResource Rule_AddTemplate}" MinWidth="96" Margin="0,0,8,0" Click="OnAddSiteTemplate"
                       Foreground="{x:Static svc:Theme.AccentGreen}" />
            <ui:Button Content="{DynamicResource Rule_AddApp}" MinWidth="96" Margin="0,0,8,0" Click="OnAddProgPath"
                       Foreground="{x:Static svc:Theme.AccentGreen}" />
            <ui:Button Content="{DynamicResource Rule_AddProcess}" MinWidth="80" Margin="0,0,8,0" Click="OnAddProgRunning"
                       Foreground="{x:Static svc:Theme.AccentGreen}" />
            <ui:Button Content="Store" MinWidth="70" Click="OnAddProgStore"
                       Foreground="{x:Static svc:Theme.AccentGreen}" />
        </StackPanel>

        <!-- ===== Row 5: VPN switches + allowed variants ===== -->
        <StackPanel x:Name="RowVpn" Grid.Row="5" Margin="20,14,20,0">
            <StackPanel Orientation="Horizontal">
                <ui:ToggleSwitch x:Name="ChkVpn" Content="{DynamicResource Rule_UseVpn}" />
                <ui:ToggleSwitch x:Name="ChkKillSwitch" Content="Kill-switch" Margin="28,0,0,0" />
            </StackPanel>

            <TextBlock Text="{DynamicResource Rule_AllowedVpn}"
                       FontSize="12.5" FontWeight="SemiBold" Margin="0,10,0,2" />
            <!-- The rows stay in the Settings order; priority is the NUMBER in the box, not the
                 row position, which is what lets the same control work here and in the VPN table
                 (where rows are rules and there is nothing to drag). -->
            <TextBlock Text="{DynamicResource Rule_VpnOrderHint}"
                       FontSize="11.5" Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,4" />
            <!-- Three columns, filled row by row: more VPN variants add a row per three
                 instead of one each, so the card doesn't keep growing down. -->
            <ItemsControl x:Name="AllowSlots">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2,12,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="28" Height="28" CornerRadius="5"
                                    BorderThickness="1" Margin="0,0,10,0" Cursor="Hand"
                                    Background="{Binding BoxFill}"
                                    BorderBrush="{Binding BoxEdge}"
                                    Tag="{Binding Id}"
                                    ToolTip="{Binding BoxTip}"
                                    MouseLeftButtonUp="OnSlotToggle">
                                <TextBlock Text="{Binding RankText}" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="#EAF1FF"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <!-- The name goes in a TextBlock, NOT in Content: a ContentPresenter
                                 treats a plain string as an access key, so "Node_1 — DE" loses its
                                 underscore and can't wrap. Star column + Wrap = the full name, as
                                 the user typed it, over as many lines as it needs. -->
                            <TextBlock Grid.Column="1" Text="{Binding Label}" TextWrapping="Wrap"
                                       FontSize="13" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="LblNoAllowSlots" Text="{DynamicResource Rule_NoVpnVariants}"
                       FontSize="12.5" Opacity="0.6" TextWrapping="Wrap"
                       Visibility="Collapsed" Margin="0,0,0,2" />
        </StackPanel>

        <!-- ===== Row 6: save / cancel ===== -->
        <Border Grid.Row="6" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="BtnSave" Content="{DynamicResource Rule_Save}" Margin="0,0,8,0"
                           Appearance="Primary" FontSize="14" Padding="20,8" Click="OnSave" />
                <ui:Button Content="{DynamicResource Rule_Cancel}" FontSize="14" Padding="20,8" Click="OnCancel" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
