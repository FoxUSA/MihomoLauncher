<ui:FluentWindow x:Class="MihomoLauncher.Views.StoreAppPickerDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{DynamicResource Dlg_StoreApps}"
                 Width="720" Height="560"
                 MinWidth="560" MinHeight="400"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="CanResize"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" x:Name="Bar" Title="{DynamicResource Dlg_StoreApps}" />

        <Grid Grid.Row="1" Margin="20,8,20,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox x:Name="TxtSearch" Grid.Column="0" PlaceholderText="{DynamicResource Dlg_SearchByName}"
                        FontSize="13" TextChanged="OnSearchChanged" />
            <ui:Button x:Name="BtnReload" Grid.Column="1" Content="{DynamicResource Dlg_Refresh}" Margin="8,0,0,0" Click="OnReload" />
        </Grid>

        <Grid Grid.Row="2" Margin="20,0,20,0">
            <ListView x:Name="LstApps"
                      SelectionMode="Single"
                      MouseDoubleClick="OnPick">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="{DynamicResource Dlg_ColApplication}" Width="260" DisplayMemberBinding="{Binding Name}" />
                        <GridViewColumn Header="{DynamicResource Dlg_ColAumid}" Width="400" DisplayMemberBinding="{Binding Aumid}" />
                    </GridView>
                </ListView.View>
            </ListView>
            <StackPanel x:Name="LoadingPanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                <ui:ProgressRing IsIndeterminate="True" Width="48" Height="48" HorizontalAlignment="Center" />
                <TextBlock Text="{DynamicResource Dlg_SearchingApps}" Margin="0,12,0,0"
                           FontSize="13" Opacity="0.7" TextAlignment="Center" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="3" Padding="20,12">
            <DockPanel>
                <TextBlock x:Name="LblHint" DockPanel.Dock="Left" VerticalAlignment="Center"
                           FontSize="12" Opacity="0.6"
                           Text="{DynamicResource Dlg_StorePickHint}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button x:Name="BtnPick" Content="{DynamicResource Dlg_Select}" Margin="0,0,8,0"
                               Appearance="Primary" FontSize="14" Padding="20,8" Click="OnPick" />
                    <ui:Button Content="{DynamicResource Dlg_Cancel}" FontSize="14" Padding="20,8" Click="OnCancel" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
