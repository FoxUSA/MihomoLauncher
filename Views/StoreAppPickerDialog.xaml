<ui:FluentWindow x:Class="MihomoLauncher.Views.StoreAppPickerDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:svc="clr-namespace:MihomoLauncher.Services"
                 Title="{DynamicResource Dlg_StoreApps}"
                 Width="720" Height="560"
                 MinWidth="560" MinHeight="400"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="CanResize"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 Background="{x:Static svc:Theme.WindowBg}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" x:Name="Bar" Title="{DynamicResource Dlg_StoreApps}" />

        <Grid Grid.Row="1" Margin="20,8,20,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox x:Name="TxtSearch" Grid.Column="0" PlaceholderText="{DynamicResource Dlg_SearchByName}"
                        FontSize="13" TextChanged="OnSearchChanged" />
            <ui:Button x:Name="BtnReload" Grid.Column="1" Content="{DynamicResource Dlg_Refresh}" Margin="8,0,0,0" Click="OnReload" />
        </Grid>

        <Grid Grid.Row="2" Margin="20,0,20,0">
            <!-- Looks like the rules list (ListsWindow.GridApps, 2026-11-22): the shared styles as they
                 are, framed like the rule editor's table this dialog is opened from. The AUMID column
                 takes the rest of the width (a ListView needed UiHelpers.FillLastGridColumn for that). -->
            <Border CornerRadius="8"
                    Background="{x:Static svc:Theme.ListBg}"
                    BorderBrush="{x:Static svc:Theme.CardBorder}" BorderThickness="1">
                <DataGrid x:Name="LstApps" Margin="-1,-1,-1,0" svc:FrameClip.Radius="7"
                          Style="{StaticResource AppDataGridStyle}"
                          RowStyle="{StaticResource AppDataGridRowStyle}"
                          CellStyle="{StaticResource AppDataGridCellStyle}"
                          ColumnHeaderStyle="{StaticResource AppColumnHeaderStyle}"
                          CanUserSortColumns="False"
                          MouseDoubleClick="OnPick">
                    <DataGrid.Columns>
                        <!-- ✓ = already in the rule: sits where the model has its checkbox column. -->
                        <DataGridTextColumn Binding="{Binding Mark}" Width="32" CanUserResize="False"
                                            CellStyle="{StaticResource CheckboxCellStyle}"
                                            HeaderStyle="{StaticResource CheckboxColumnHeaderStyle}" />
                        <DataGridTextColumn Header="{DynamicResource Dlg_ColApplication}" Binding="{Binding Name}" Width="260"
                                            ElementStyle="{StaticResource TruncatedTextStyle}" />
                        <DataGridTextColumn Header="{DynamicResource Dlg_ColAumid}" Binding="{Binding Aumid}" Width="*"
                                            ElementStyle="{StaticResource TruncatedTextStyle}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <StackPanel x:Name="LoadingPanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                <ui:ProgressRing IsIndeterminate="True" Width="48" Height="48" HorizontalAlignment="Center" />
                <TextBlock Text="{DynamicResource Dlg_SearchingApps}" Margin="0,12,0,0"
                           FontSize="13" Opacity="0.7" TextAlignment="Center" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="3" Padding="20,12">
            <DockPanel>
                <TextBlock x:Name="LblHint" DockPanel.Dock="Left" VerticalAlignment="Center"
                           FontSize="12" Opacity="0.6"
                           Text="{DynamicResource Dlg_StorePickHint}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button x:Name="BtnPick" Content="{DynamicResource Dlg_Select}" Margin="0,0,8,0"
                               Appearance="Primary" FontSize="14" Padding="20,8" Click="OnPick" />
                    <ui:Button Content="{DynamicResource Dlg_Cancel}" FontSize="14" Padding="20,8" Click="OnCancel" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
