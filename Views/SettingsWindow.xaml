<ui:FluentWindow x:Class="MihomoLauncher.Views.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:svc="clr-namespace:MihomoLauncher.Services"
                 Title="{DynamicResource Set_Title}"
                 Width="950" Height="780"
                 MinWidth="820" MinHeight="560"
                 WindowStartupLocation="CenterScreen"
                 ResizeMode="CanResize"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <ui:FluentWindow.Resources>
        <!-- Custom TabControl chrome: headers in a plain horizontal StackPanel (no TabPanel
             deformation, no WPF-UI selection indicator), content in a stretching host
             (mirrors the framework's standard template so the tables fill the area). -->
        <Style x:Key="CardTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid ClipToBounds="True" SnapsToDevicePixels="True"
                              KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" IsItemsHost="True" Orientation="Horizontal"
                                        Panel.ZIndex="1" Background="Transparent" Margin="0,0,0,8" />
                            <Border Grid.Row="1"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    KeyboardNavigation.DirectionalNavigation="Contained"
                                    KeyboardNavigation.TabNavigation="Local">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pill-style tab headers so the Программы/Ссылки tabs don't blend into the card. -->
        <Style x:Key="CardTabItemStyle" TargetType="TabItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{x:Static svc:Theme.TextSecondary}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <!-- Don't let the header panel stretch the pill vertically (that elongates the
                 rounded corners and makes the shape look crooked). -->
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Height="34" Padding="16,0" CornerRadius="6"
                                SnapsToDevicePixels="True"
                                Background="{x:Static svc:Theme.BadgeNeutralBg}"
                                BorderBrush="{x:Static svc:Theme.CardBorder}"
                                BorderThickness="1"
                                TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{x:Static svc:Theme.CardBgHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{x:Static svc:Theme.SelectionBg}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{x:Static svc:Theme.SelectionBg}" />
                                <Setter Property="Foreground" Value="{x:Static svc:Theme.TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>
    <Grid x:Name="RootGrid" Background="Transparent"
          Focusable="True" FocusVisualStyle="{x:Null}"
          MouseDown="OnBackgroundMouseDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{DynamicResource Set_Title}" Panel.ZIndex="0" />

        <TabControl x:Name="Tabs" Grid.Row="1" Margin="16,8,16,0"
                    Style="{StaticResource CardTabControlStyle}"
                    SelectionChanged="OnTabsSelectionChanged">

            <!-- ============ TAB 1: Основное (VPN variants + Programs/Links) ============ -->
            <TabItem Header="{DynamicResource Set_TabMain}" Style="{StaticResource CardTabItemStyle}">
                <!-- Variants take only the height their rows need (Auto), capped at half the tab
                     (CardSlots.MaxHeight, set in OnMainTabSizeChanged); the rules get the rest.
                     Few variants → the rules table is taller; once the variants fill their half
                     it's 50/50 and the variants scroll. -->
                <Grid Margin="4,10,4,4" SizeChanged="OnMainTabSizeChanged">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- ===== Top: VPN variants table (full width) ===== -->
                    <ui:Card x:Name="CardSlots" Grid.Row="0" Margin="0,0,0,4" Padding="14"
                             VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Buttons on top (left), title on the right -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <ui:Button Content="{DynamicResource Set_BtnAdd}" Margin="0,0,8,0" MinWidth="92" Click="OnAddSlot"
                                               Foreground="{x:Static svc:Theme.AccentGreen}" />
                                    <ui:Button Content="{DynamicResource Set_BtnEdit}" Margin="0,0,8,0" MinWidth="92" Click="OnEditSlot" />
                                    <ui:Button Content="{DynamicResource Set_BtnDelete}" Margin="0,0,8,0" MinWidth="92" Click="OnDeleteSlot" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{DynamicResource Set_VpnVariants}" FontSize="17" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="12,0,2,0" />
                            </Grid>

                            <DataGrid x:Name="GridSlots" Grid.Row="1"
                                      Style="{StaticResource AppDataGridStyle}"
                                      RowStyle="{StaticResource AppDataGridRowStyle}"
                                      CellStyle="{StaticResource AppDataGridCellStyle}"
                                      ColumnHeaderStyle="{StaticResource AppColumnHeaderStyle}"
                                      CanUserSortColumns="False"
                                      MouseDoubleClick="OnEditSlot">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="32" CanUserSort="False" CanUserResize="False"
                                                            CellStyle="{StaticResource CheckboxCellStyle}"
                                                            HeaderStyle="{StaticResource CheckboxColumnHeaderStyle}">
                                        <DataGridTemplateColumn.HeaderTemplate>
                                            <DataTemplate>
                                                <Border Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                        Tag="slots" PreviewMouseLeftButtonDown="HeaderCheck_Click">
                                                    <CheckBox Style="{StaticResource DataGridCheckBoxStyle}"
                                                              IsChecked="{Binding DataContext.AllSlotsChecked, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWay}"
                                                              IsThreeState="True" IsHitTestVisible="False" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.HeaderTemplate>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                        PreviewMouseLeftButtonDown="CellCheck_Click">
                                                    <CheckBox Style="{StaticResource DataGridCheckBoxStyle}"
                                                              IsChecked="{Binding IsChecked, Mode=OneWay}"
                                                              IsHitTestVisible="False" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <!-- Everything but «Значение» is sized to its content; the value
                                         column takes all the slack, since it's the one holding
                                         long paths/URLs. MaxWidth keeps one long name from eating
                                         the row (the text style truncates past it). -->
                                    <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="Auto" />
                                    <DataGridTextColumn Header="{DynamicResource Set_ColName}" Binding="{Binding Name}" Width="Auto" MaxWidth="260"
                                                        ElementStyle="{StaticResource TruncatedTextStyle}" />
                                    <DataGridTextColumn Header="{DynamicResource Set_ColType}" Binding="{Binding KindLabel}" Width="Auto" />
                                    <DataGridTextColumn Header="{DynamicResource Set_ColValue}" Binding="{Binding ValueLabel}" Width="*"
                                                        ElementStyle="{StaticResource TruncatedTextStyle}" />
                                    <DataGridTextColumn Header="{DynamicResource Set_ColEnabled}" Binding="{Binding EnabledLabel}" Width="Auto" />
                                    <!-- What the last connect saw: answers / doesn't answer / blank
                                         if it was never checked. Read-only; filled by the preflight
                                         the connect flow runs before it picks a variant. -->
                                    <DataGridTextColumn Header="{DynamicResource Set_ColSlotStatus}" Binding="{Binding StatusLabel}" Width="Auto" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </ui:Card>

                    <!-- ===== Bottom half: Правила (программы + ссылки в одном списке) ===== -->
                    <ui:Card Grid.Row="1" Margin="0,4,0,0" Padding="6"
                             VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <Grid Margin="8,10,8,6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <ui:Button Content="{DynamicResource Set_BtnAdd}" Margin="0,0,8,0" MinWidth="92" Click="OnAddApp"
                                               Foreground="{x:Static svc:Theme.AccentGreen}" />
                                    <ui:Button Content="{DynamicResource Set_BtnEdit}" Margin="0,0,8,0" MinWidth="92" Click="OnEditApp" />
                                    <ui:Button Content="{DynamicResource Set_BtnDelete}" Margin="0,0,8,0" MinWidth="92" Click="OnDeleteApp" />
                                    <ui:Button x:Name="BtnRefreshLink" Content="{DynamicResource Set_BtnRefreshLists}"
                                               Margin="0,0,8,0" MinWidth="92" Click="OnRefreshRules" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{DynamicResource Set_Rules}" FontSize="16" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="12,0,2,0" />
                            </Grid>

                            <DataGrid x:Name="GridApps" Grid.Row="1"
                                      Style="{StaticResource AppDataGridStyle}"
                                      RowStyle="{StaticResource AppDataGridRowStyle}"
                                      CellStyle="{StaticResource AppDataGridCellStyle}"
                                      ColumnHeaderStyle="{StaticResource AppColumnHeaderStyle}"
                                      CanUserSortColumns="False"
                                      MouseDoubleClick="OnEditApp">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="32" CanUserSort="False" CanUserResize="False"
                                                            CellStyle="{StaticResource CheckboxCellStyle}"
                                                            HeaderStyle="{StaticResource CheckboxColumnHeaderStyle}">
                                        <DataGridTemplateColumn.HeaderTemplate>
                                            <DataTemplate>
                                                <Border Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                        Tag="apps" PreviewMouseLeftButtonDown="HeaderCheck_Click">
                                                    <CheckBox Style="{StaticResource DataGridCheckBoxStyle}"
                                                              IsChecked="{Binding DataContext.AllAppsChecked, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWay}"
                                                              IsThreeState="True" IsHitTestVisible="False" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.HeaderTemplate>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                        PreviewMouseLeftButtonDown="CellCheck_Click">
                                                    <CheckBox Style="{StaticResource DataGridCheckBoxStyle}"
                                                              IsChecked="{Binding IsChecked, Mode=OneWay}"
                                                              IsHitTestVisible="False" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <!-- Same shape as the variants table: content-sized columns,
                                         and «Путь» (what the rule actually points at) gets the rest. -->
                                    <DataGridTextColumn Header="{DynamicResource Set_ColName}" Binding="{Binding Name}" Width="Auto" MaxWidth="260"
                                                        ElementStyle="{StaticResource TruncatedTextStyle}" />
                                    <DataGridTextColumn Header="{DynamicResource Set_ColPath}" Binding="{Binding DisplayPath}" Width="*"
                                                        ElementStyle="{StaticResource TruncatedTextStyle}" />
                                    <DataGridTextColumn Header="VPN" Binding="{Binding VpnLabel}" Width="Auto" />
                                    <DataGridTextColumn Header="Kill-switch" Binding="{Binding KillSwitchLabel}" Width="Auto" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </ui:Card>
                </Grid>
            </TabItem>

            <!-- ============ TAB 2: Mihomo (engine + diagnostics) ============ -->
            <TabItem Header="Mihomo" Style="{StaticResource CardTabItemStyle}">
                <ScrollViewer Margin="4,10,0,4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                <Grid Margin="0,0,10,0" MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <!-- Routes table takes the slack so it grows with the window height
                             (like the bottom grid on the «Основное» tab), instead of leaving
                             empty space below. -->
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="{DynamicResource Set_MihomoEngine}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <ui:Button x:Name="BtnRefreshDiag" HorizontalAlignment="Right" Content="{DynamicResource Set_BtnRefreshStatus}" Click="OnRefreshDiag" />
                    </Grid>

                    <!-- mihomo runtime settings (moved from the Настройки tab) -->
                    <ui:Card Grid.Row="1" Padding="14" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Set_MihomoExePath}" FontSize="13" Margin="0,0,0,2" />
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox x:Name="TxtMihomoExe" Grid.Column="0" FontSize="13" />
                                <ui:Button Grid.Column="1" Content="{DynamicResource Set_BtnBrowse}" Margin="6,0,0,0" Click="OnBrowseMihomo" />
                            </Grid>
                            <TextBlock x:Name="LblMihomoExeHint" FontSize="12" Opacity="0.6"
                                       TextWrapping="Wrap" Margin="0,0,0,9" />

                            <TextBlock Text="{DynamicResource Set_MihomoWorkDir}" FontSize="13" Margin="0,0,0,2" />
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox x:Name="TxtMihomoWorkDir" Grid.Column="0" FontSize="13" />
                                <ui:Button Grid.Column="1" Content="{DynamicResource Set_BtnBrowse}" Margin="6,0,0,0" Click="OnBrowseWorkDir" />
                            </Grid>

                            <StackPanel Orientation="Horizontal">
                                <ui:Button x:Name="BtnSetupMihomo" Content="{DynamicResource Set_BtnSetupMihomo}"
                                           HorizontalAlignment="Left" Click="OnSetupMihomo">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="ShieldKeyhole24" />
                                    </ui:Button.Icon>
                                </ui:Button>
                                <TextBlock x:Name="LblMihomoStatus" Margin="12,0,0,0" FontSize="13"
                                           FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" Text="" />
                            </StackPanel>

                            <!-- "Remote desktop session" safe mode (same toggle as on the main
                                 screen): force-stop mihomo every 60s so a bad config can't lock
                                 you out remotely. -->
                            <ui:ToggleSwitch x:Name="SwitchSafeMode" Margin="0,12,0,0"
                                             Content="{DynamicResource Main_KillTimerLabel}" />
                            <TextBlock Text="{DynamicResource Set_SafeModeHint}" FontSize="12"
                                       Opacity="0.6" TextWrapping="Wrap" Margin="0,3,0,0" />

                            <!-- Firewall kill-switch: the protection that keeps working when the
                                 engine does not. -->
                            <ui:ToggleSwitch x:Name="SwitchFirewall" Margin="0,14,0,0"
                                             Content="{DynamicResource Set_FirewallLabel}" />
                            <TextBlock Text="{DynamicResource Set_FirewallHint}" FontSize="12"
                                       Opacity="0.6" TextWrapping="Wrap" Margin="0,3,0,0" />
                            <TextBlock x:Name="LblFirewallStatus" FontSize="12" FontWeight="SemiBold"
                                       TextWrapping="Wrap" Margin="0,4,0,0" Text="" />
                        </StackPanel>
                    </ui:Card>

                    <!-- Engine status -->
                    <ui:Card Grid.Row="2" Padding="14" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Set_EngineStatus}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBlock x:Name="LblDiagEngine" FontSize="13" TextWrapping="Wrap" Text="—" />
                        </StackPanel>
                    </ui:Card>

                    <!-- Active routes -->
                    <TextBlock Grid.Row="3" Text="{DynamicResource Set_NowViaTunnel}" FontSize="14" FontWeight="SemiBold" Margin="2,4,0,4" />
                    <ui:Card Grid.Row="4" Padding="6" Margin="0,0,0,8">
                        <Grid>
                            <ListView x:Name="LstRoutes" MinHeight="90" SelectionMode="Single">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="{DynamicResource Set_ColApp}" Width="180" DisplayMemberBinding="{Binding AppName}" />
                                        <GridViewColumn Header="{DynamicResource Set_ColVariant}" Width="200" DisplayMemberBinding="{Binding SlotLabel}" />
                                        <GridViewColumn Header="{DynamicResource Set_ColNode}" Width="170" DisplayMemberBinding="{Binding ProxyName}" />
                                        <GridViewColumn Header="{DynamicResource Set_ColSite}" Width="180" DisplayMemberBinding="{Binding Target}" />
                                        <GridViewColumn Header="{DynamicResource Set_ColStatus}" Width="110" DisplayMemberBinding="{Binding StatusLabel}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            <TextBlock x:Name="LblNoRoutes"
                                       Text="{DynamicResource Set_NoRoutes}"
                                       FontSize="13" Opacity="0.6"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                        </Grid>
                    </ui:Card>

                    <!-- Applied config — opens in a separate window -->
                    <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="2,4,0,0">
                        <ui:Button x:Name="BtnShowConfig" Content="{DynamicResource Set_BtnShowConfig}" Click="OnShowConfig">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="DocumentText24" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12" Opacity="0.6"
                                   Text="{DynamicResource Set_ShowConfigHint}" />
                    </StackPanel>
                </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ============ TAB 3: DNS — for DIRECT traffic only ============
                 The old «DNS» tab (removed 2026-08-15) replaced the resolver of the whole
                 machine and could hold up VPN traffic too. This one feeds mihomo's
                 `direct-nameserver` and nothing else — see DirectDns. -->
            <TabItem x:Name="TabDns" Header="DNS" Style="{StaticResource CardTabItemStyle}">
                <ScrollViewer Margin="4,10,0,4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                <Grid Margin="0,0,10,0" MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <ui:Card Grid.Row="0" Padding="14" Margin="0,0,0,8">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Set_DnsTitle}" FontSize="16" FontWeight="SemiBold"
                                           VerticalAlignment="Center" TextWrapping="Wrap" />
                                <ui:ToggleSwitch x:Name="SwitchDirectDns" Grid.Column="1" VerticalAlignment="Center"
                                                 Checked="OnDirectDnsToggle" Unchecked="OnDirectDnsToggle" />
                            </Grid>
                            <TextBlock Text="{DynamicResource Set_DnsDesc}" FontSize="12" Opacity="0.65"
                                       TextWrapping="Wrap" Margin="0,0,0,10" />

                            <!-- Whose servers: the typed ones, or the DNS a Clash subscription
                                 sends. Only shown when some subscription sends DNS; the options
                                 are made in code (DirectDns.Offered). -->
                            <StackPanel x:Name="PnlDnsSource" Margin="0,0,0,12" Visibility="Collapsed">
                                <TextBlock Text="{DynamicResource Set_DnsSourceTitle}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <RadioButton x:Name="RbDnsOwn" GroupName="DnsSource" Margin="0,2,0,2"
                                             Checked="OnDnsSourceChanged">
                                    <TextBlock Text="{DynamicResource Set_DnsSourceOwn}" TextWrapping="Wrap" />
                                </RadioButton>
                                <StackPanel x:Name="PnlDnsOffers" />
                            </StackPanel>

                            <Grid x:Name="PnlDnsFields">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Set_DnsPrimary}" FontSize="13"
                                           VerticalAlignment="Center" Margin="0,0,10,0" MinWidth="70" />
                                <ui:TextBox x:Name="TxtDns1" Grid.Row="0" Grid.Column="1" FontSize="13"
                                            PlaceholderText="{DynamicResource Set_DnsPlaceholder}"
                                            TextChanged="OnDnsTextChanged" LostFocus="OnDns1LostFocus" />
                                <TextBlock x:Name="LblDns1" Grid.Row="1" Grid.Column="1" FontSize="12" Margin="2,3,0,8"
                                           TextWrapping="Wrap" Text="" />

                                <TextBlock x:Name="LblDns2Caption" Grid.Row="2" Grid.Column="0" Text="{DynamicResource Set_DnsSecondary}"
                                           FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <ui:TextBox x:Name="TxtDns2" Grid.Row="2" Grid.Column="1" FontSize="13"
                                            PlaceholderText="{DynamicResource Set_DnsPlaceholder2}"
                                            TextChanged="OnDnsTextChanged" />
                                <TextBlock x:Name="LblDns2" Grid.Row="3" Grid.Column="1" FontSize="12" Margin="2,3,0,8"
                                           TextWrapping="Wrap" Text="" />
                            </Grid>

                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:Button x:Name="BtnDnsTest" Content="{DynamicResource Set_DnsTest}" Click="OnDnsTest"
                                           VerticalAlignment="Top">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="GlobeSearch24" />
                                    </ui:Button.Icon>
                                </ui:Button>
                                <TextBlock x:Name="LblDnsTest" Grid.Column="1" Margin="12,0,0,0" FontSize="12.5"
                                           VerticalAlignment="Center" TextWrapping="Wrap" Text="" />
                            </Grid>
                            <TextBlock Text="{DynamicResource Set_DnsFormats}" FontSize="11" Opacity="0.55"
                                       TextWrapping="Wrap" Margin="0,10,0,0" />
                        </StackPanel>
                    </ui:Card>

                    <ui:Card Grid.Row="1" Padding="14" Margin="0,0,0,8" VerticalAlignment="Stretch"
                             VerticalContentAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Set_DnsDirectNow}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBlock x:Name="LblDnsDirect" FontSize="12.5" TextWrapping="Wrap" Text="" />
                            <TextBlock Text="{DynamicResource Set_DnsJournalHint}" FontSize="11" Opacity="0.55"
                                       TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </ui:Card>
                </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ============ TAB 3: Обновление (per-item update + periods) ============ -->
            <TabItem Header="{DynamicResource Set_TabUpdates}" Style="{StaticResource CardTabItemStyle}">
                <ScrollViewer Margin="4,10,0,4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                <Grid x:Name="UpdateTabRoot" Margin="0,0,10,0" MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                      Focusable="True" FocusVisualStyle="{x:Null}"
                      IsVisibleChanged="OnUpdateTabVisibleChanged">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- ===== Программа (лаунчер) ===== -->
                    <ui:Card Grid.Row="0" Padding="14" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource Upd_ItemApp}" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock x:Name="LblAppInfo" FontSize="12" Opacity="0.7" TextWrapping="Wrap" Margin="0,3,0,0" Text="—" />
                                <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                    <TextBlock Text="{DynamicResource Upd_CheckEvery}" VerticalAlignment="Center" FontSize="12" />
                                    <ui:TextBox x:Name="TxtAppPeriod" Width="72" MaxLength="4" Margin="8,0,6,0" FontSize="13"
                                                ClearButtonEnabled="False" TextAlignment="Center"
                                                VerticalContentAlignment="Center" />
                                    <TextBlock Text="{DynamicResource Upd_Days}" VerticalAlignment="Center" FontSize="12" />
                                </StackPanel>
                            </StackPanel>
                            <ui:Button Grid.Column="1" x:Name="BtnUpdateApp" Content="{DynamicResource Upd_BtnCheck}"
                                       VerticalAlignment="Center" MinWidth="180" Click="OnUpdateApp" />
                        </Grid>
                    </ui:Card>

                    <!-- ===== Движок Mihomo ===== -->
                    <ui:Card Grid.Row="1" Padding="14" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource Upd_ItemEngine}" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock x:Name="LblEngineInfo" FontSize="12" Opacity="0.7" TextWrapping="Wrap" Margin="0,3,0,0" Text="—" />
                                <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                    <TextBlock Text="{DynamicResource Upd_CheckEvery}" VerticalAlignment="Center" FontSize="12" />
                                    <ui:TextBox x:Name="TxtEnginePeriod" Width="72" MaxLength="4" Margin="8,0,6,0" FontSize="13"
                                                ClearButtonEnabled="False" TextAlignment="Center"
                                                VerticalContentAlignment="Center" />
                                    <TextBlock Text="{DynamicResource Upd_Days}" VerticalAlignment="Center" FontSize="12" />
                                </StackPanel>
                            </StackPanel>
                            <ui:Button Grid.Column="1" x:Name="BtnUpdateEngine" Content="{DynamicResource Upd_BtnCheck}"
                                       VerticalAlignment="Center" MinWidth="180" Click="OnUpdateEngine" />
                        </Grid>
                    </ui:Card>

                    <!-- ===== База Гео ===== -->
                    <ui:Card Grid.Row="2" Padding="14" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource Upd_ItemGeo}" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock x:Name="LblGeoInfo" FontSize="12" Opacity="0.7" TextWrapping="Wrap" Margin="0,3,0,0" Text="—" />
                                <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                    <TextBlock Text="{DynamicResource Upd_CheckEvery}" VerticalAlignment="Center" FontSize="12" />
                                    <ui:TextBox x:Name="TxtGeoPeriod" Width="72" MaxLength="4" Margin="8,0,6,0" FontSize="13"
                                                ClearButtonEnabled="False" TextAlignment="Center"
                                                VerticalContentAlignment="Center" />
                                    <TextBlock Text="{DynamicResource Upd_Days}" VerticalAlignment="Center" FontSize="12" />
                                </StackPanel>
                            </StackPanel>
                            <ui:Button Grid.Column="1" x:Name="BtnUpdateGeo" Content="{DynamicResource Upd_BtnCheck}"
                                       VerticalAlignment="Center" MinWidth="180" Click="OnUpdateGeo" />
                        </Grid>
                    </ui:Card>

                    <!-- ===== Шаблоны правил ===== -->
                    <ui:Card Grid.Row="3" Padding="14" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource Upd_ItemTemplates}" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock x:Name="LblTplInfo" FontSize="12" Opacity="0.7" TextWrapping="Wrap" Margin="0,3,0,0" Text="—" />
                                <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                    <TextBlock Text="{DynamicResource Upd_CheckEvery}" VerticalAlignment="Center" FontSize="12" />
                                    <ui:TextBox x:Name="TxtTplPeriod" Width="72" MaxLength="4" Margin="8,0,6,0" FontSize="13"
                                                ClearButtonEnabled="False" TextAlignment="Center"
                                                VerticalContentAlignment="Center" />
                                    <TextBlock Text="{DynamicResource Upd_Days}" VerticalAlignment="Center" FontSize="12" />
                                </StackPanel>
                            </StackPanel>
                            <ui:Button Grid.Column="1" x:Name="BtnUpdateTpl" Content="{DynamicResource Upd_BtnCheck}"
                                       VerticalAlignment="Center" MinWidth="180" Click="OnUpdateTemplates" />
                        </Grid>
                    </ui:Card>

                    <!-- ===== Shared progress / status ===== -->
                    <StackPanel Grid.Row="5" Margin="2,4,2,0">
                        <ProgressBar x:Name="UpdProgress" Height="6" Minimum="0" Maximum="100"
                                     Visibility="Collapsed" />
                        <TextBlock x:Name="LblUpdStatus" FontSize="12" Opacity="0.85" TextWrapping="Wrap"
                                   Margin="0,7,0,0" Text="" />
                    </StackPanel>
                </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ============ TAB 5: Config (launcher-level options) ============ -->
            <TabItem Header="{DynamicResource Set_TabSettings}" Style="{StaticResource CardTabItemStyle}">
                <ScrollViewer Margin="4,10,0,4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                <Grid Margin="0,0,10,0" MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                    <ui:Card Padding="14" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Set_ConfigFileTitle}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBlock Text="{DynamicResource Set_ConfigFileDesc}"
                                       FontSize="12" Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox x:Name="TxtConfigPath" Grid.Column="0" FontSize="13" />
                                <ui:Button Grid.Column="1" Content="{DynamicResource Set_BtnBrowse}" Margin="6,0,0,0" Click="OnBrowseConfigPath" />
                            </Grid>
                            <TextBlock x:Name="LblConfigPathHint" FontSize="11" Opacity="0.6" TextWrapping="Wrap" Text="" />

                            <Separator Margin="0,14,0,10" Opacity="0.4" />

                            <CheckBox x:Name="ChkAutostart"
                                      FontSize="13"
                                      HorizontalContentAlignment="Stretch">
                                <TextBlock Text="{DynamicResource Set_Autostart}"
                                           TextWrapping="Wrap" VerticalAlignment="Center" />
                            </CheckBox>
                            <TextBlock Text="{DynamicResource Set_AutostartHint}"
                                       FontSize="11" Opacity="0.6" TextWrapping="Wrap"
                                       Margin="28,2,0,0" />
                        </StackPanel>
                    </ui:Card>
                </Grid>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- Footer buttons -->
        <Border Grid.Row="2" Padding="20,8">
            <DockPanel>
                <ui:Button Content="{DynamicResource Set_BtnExitApp}"
                           DockPanel.Dock="Left"
                           FontSize="14"
                           Padding="20,8"
                           Appearance="Danger"
                           Click="OnExitApp" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button x:Name="BtnSave" Content="{DynamicResource Set_BtnSave}" Margin="0,0,8,0" Appearance="Primary" FontSize="14" Padding="20,8" Click="OnSave" />
                    <ui:Button Content="{DynamicResource Set_BtnCancel}" FontSize="14" Padding="20,8" Click="OnCancel" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Exit confirmation toast — overlays whole window incl. title bar; click on backdrop = cancel -->
        <Grid x:Name="ExitConfirmOverlay"
              Grid.Row="0" Grid.RowSpan="3"
              Background="#80000000"
              Visibility="Collapsed"
              MouseLeftButtonDown="OnExitOverlayBackdropClick"
              Panel.ZIndex="100">
            <Border Width="380"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{x:Static svc:Theme.OverlayCardBg}"
                    BorderBrush="{x:Static svc:Theme.CardBorder}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="20,18"
                    MouseLeftButtonDown="OnExitToastClick">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="2" Opacity="0.35" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="{DynamicResource Set_ExitConfirmTitle}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6" />
                    <TextBlock FontSize="13"
                               Opacity="0.8"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16"
                               Text="{DynamicResource Set_ExitConfirmBody}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Content="{DynamicResource Set_BtnExit}"
                                   FontSize="13"
                                   Padding="16,6"
                                   Margin="0,0,8,0"
                                   Appearance="Danger"
                                   Click="OnExitConfirm" />
                        <ui:Button Content="{DynamicResource Set_BtnCancel}"
                                   FontSize="13"
                                   Padding="16,6"
                                   Click="OnExitCancel" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
