<ui:FluentWindow x:Class="MihomoLauncher.Views.SubscriptionDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:svc="clr-namespace:MihomoLauncher.Services"
                 Width="720" Height="720"
                 MinWidth="560" MinHeight="480"
                 ResizeMode="CanResize"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" ShowMaximize="False" ShowMinimize="False" />

        <!-- What it is: name, servers, lists, when it was downloaded -->
        <StackPanel Grid.Row="1" Margin="20,0,20,10">
            <TextBlock x:Name="LblTitle" FontSize="20" FontWeight="SemiBold"
                       Foreground="{x:Static svc:Theme.TextPrimary}" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="LblSummary" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                       Foreground="{x:Static svc:Theme.TextSecondary}" />
        </StackPanel>

        <!-- «Обновить» in progress: what's being fetched, how much, how fast, how long -->
        <Border Grid.Row="2" x:Name="PanelProgress" Margin="20,0,20,12" Padding="14,12" CornerRadius="8"
                Background="{x:Static svc:Theme.BannerInfoBg}" BorderBrush="{x:Static svc:Theme.BannerInfoBorder}"
                BorderThickness="1" Visibility="Collapsed">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LblStep" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               Foreground="{x:Static svc:Theme.TextPrimary}" />
                    <TextBlock Grid.Column="1" x:Name="LblPercent" FontSize="13" Margin="12,0,0,0"
                               Foreground="{x:Static svc:Theme.TextPrimary}" />
                </Grid>
                <ProgressBar x:Name="Bar" Height="6" Minimum="0" Maximum="100" Margin="0,8,0,0" />
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LblBytes" FontSize="12" Foreground="{x:Static svc:Theme.TextSecondary}" />
                    <TextBlock Grid.Column="1" x:Name="LblEta" FontSize="12" Margin="12,0,0,0"
                               Foreground="{x:Static svc:Theme.TextSecondary}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- The rules, one row per list, in the order the engine checks them -->
        <Grid Grid.Row="3" x:Name="ViewLists" Margin="20,0,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!-- Search through every list at once: a site, an IP or a mask (*.nextdns.io). -->
            <ui:TextBox x:Name="TxtFind" Grid.Row="0" FontSize="13" Margin="0,0,0,6"
                        PlaceholderText="{DynamicResource Sub_FindHint}"
                        TextChanged="OnFindChanged" KeyDown="OnFindKeyDown">
                <ui:TextBox.Icon>
                    <ui:SymbolIcon Symbol="Search24" />
                </ui:TextBox.Icon>
            </ui:TextBox>
            <Border Grid.Row="1" x:Name="FindBox" Margin="0,0,0,8" Padding="12,8" CornerRadius="8"
                    Background="{x:Static svc:Theme.BannerInfoBg}" BorderBrush="{x:Static svc:Theme.BannerInfoBorder}"
                    BorderThickness="1" Visibility="Collapsed">
                <TextBlock x:Name="LblFind" FontSize="12.5" TextWrapping="Wrap" Foreground="{x:Static svc:Theme.TextPrimary}" />
            </Border>
            <TextBlock x:Name="LblHint" Grid.Row="2" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                       Foreground="{x:Static svc:Theme.TextMuted}" Text="{DynamicResource Sub_OrderHint}" />
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="RowsHost" />
            </ScrollViewer>
        </Grid>

        <!-- One list opened: everything in it, searchable -->
        <Grid Grid.Row="3" x:Name="ViewEntries" Margin="20,0,20,0" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:Button Content="{DynamicResource Sub_Back}" Click="OnBack" FontSize="13" Padding="12,6" />
                <TextBlock Grid.Column="1" x:Name="LblListTitle" FontSize="16" FontWeight="SemiBold" Margin="14,0,10,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{x:Static svc:Theme.TextPrimary}" />
                <ContentControl Grid.Column="2" x:Name="ListBadge" VerticalAlignment="Center" />
            </Grid>
            <ui:TextBox Grid.Row="1" x:Name="TxtSearch" Margin="0,0,0,8" FontSize="13"
                        PlaceholderText="{DynamicResource Sub_Search}" TextChanged="OnSearchChanged" />
            <ListBox Grid.Row="2" x:Name="EntriesHost"
                     Background="{x:Static svc:Theme.ListBg}" BorderThickness="0" Padding="4"
                     FontFamily="Consolas" FontSize="12.5"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="8,2" />
                        <Setter Property="Foreground" Value="{x:Static svc:Theme.TextPrimary}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter Margin="{TemplateBinding Padding}" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
            <TextBlock Grid.Row="3" x:Name="LblShown" FontSize="12" Margin="0,6,0,0"
                       Foreground="{x:Static svc:Theme.TextMuted}" />
        </Grid>

        <Border Grid.Row="4" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="BtnRefresh" Content="{DynamicResource Set_BtnRefresh}" Appearance="Primary"
                           FontSize="14" Padding="20,8" Margin="0,0,8,0" Click="OnRefresh" />
                <ui:Button Content="{DynamicResource Dlg_Close}" FontSize="14" Padding="20,8" Click="OnClose" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
