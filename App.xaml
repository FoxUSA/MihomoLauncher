<Application x:Class="MihomoLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!-- No StartupUri: App.OnStartup decides which window to show (normal launcher, the update
         applier, or the uninstaller). Setting StartupUri=null at runtime throws, so we never
         set it and create the right window in code instead. -->
    <!-- NO colours in this file (2026-11-24). Each theme keeps all of its colours in its own
         folder: Themes\Dark\, Themes\Light\ (Palette.xaml + Styles.xaml). Services/Theme.cs puts
         the chosen theme's palette into these resources at startup and on every switch; the
         ThemesDictionary below is only the library's starting point — Theme.Apply swaps it. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <!-- Shared by both themes: shapes and sizes, colours only by key. -->
                <ResourceDictionary Source="pack://application:,,,/Themes/Common/Styles.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Themes/Common/DataGridStyles.xaml" />
                <!-- Themes\<theme>\Styles.xaml is merged after these by Theme.Apply. -->
            </ResourceDictionary.MergedDictionaries>

            <!-- ===== Buttons: four roles, defined once =====
                 default — the library's button; primary — Appearance="Primary" (the one accent,
                 handed to the library by Theme.Apply); «add» and danger below. Here and not in
                 Themes\Common: BasedOn needs the library's button style by StaticResource, which
                 only resolves next to the merged ControlsDictionary. Colours by key, as everywhere. -->
            <!-- «Add»: the default button with green text (green = add / ok). -->
            <Style x:Key="AddButtonStyle" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Foreground" Value="{DynamicResource Theme.AccentGreen}" />
            </Style>
            <!-- Danger: muted red fill, primary text. Not Appearance="Danger" — the library's red is
                 the loudest colour in any window, and a rare destructive action must not be. -->
            <Style x:Key="DangerButtonStyle" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Background" Value="{DynamicResource Theme.DangerBg}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Theme.DangerBg}" />
                <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}" />
                <Setter Property="MouseOverBackground" Value="{DynamicResource Theme.DangerBgHover}" />
                <Setter Property="MouseOverBorderBrush" Value="{DynamicResource Theme.DangerBgHover}" />
                <Setter Property="PressedBackground" Value="{DynamicResource Theme.DangerBg}" />
                <Setter Property="PressedBorderBrush" Value="{DynamicResource Theme.DangerBg}" />
                <Setter Property="PressedForeground" Value="{DynamicResource Theme.TextPrimary}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
