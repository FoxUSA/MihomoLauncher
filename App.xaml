<Application x:Class="MihomoLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:svc="clr-namespace:MihomoLauncher.Services">
    <!-- No StartupUri: App.OnStartup decides which window to show (normal launcher, the update
         applier, or the uninstaller). Setting StartupUri=null at runtime throws, so we never
         set it and create the right window in code instead. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="pack://application:,,,/Themes/DataGridStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- WPF-UI 4.x does not theme the native ListView / GridView, so they render
                 bright white in a dark window. These implicit styles give the tables a
                 recessed dark look that matches the rest of the app. -->

            <!-- Column header -->
            <Style TargetType="{x:Type GridViewColumnHeader}">
                <Setter Property="Foreground" Value="{x:Static svc:Theme.TextSecondary}" />
                <Setter Property="Background" Value="{x:Static svc:Theme.BadgeNeutralBg}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="10,7" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type GridViewColumnHeader}">
                            <!-- Only a bottom rule, no vertical separators — so the GridView's
                                 trailing filler strip (leftover width after the last real
                                 column) is just empty header bar, never a phantom column. -->
                            <Border x:Name="HeaderBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{x:Static svc:Theme.CardBorder}"
                                    BorderThickness="0,0,0,1"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="HeaderBorder" Property="Background" Value="{x:Static svc:Theme.CardBgHover}" />
                                </Trigger>
                                <Trigger Property="Role" Value="Padding">
                                    <Setter TargetName="HeaderBorder" Property="Background" Value="{x:Static svc:Theme.BadgeNeutralBg}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Rows -->
            <Style TargetType="{x:Type ListViewItem}">
                <Setter Property="Foreground" Value="{x:Static svc:Theme.TextPrimary}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListViewItem}">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}"
                                    CornerRadius="6"
                                    Margin="2,1"
                                    SnapsToDevicePixels="True">
                                <GridViewRowPresenter Content="{TemplateBinding Content}"
                                                      Columns="{TemplateBinding GridView.ColumnCollection}"
                                                      VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{x:Static svc:Theme.CardBgHover}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{x:Static svc:Theme.SelectionBg}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The table itself: recessed dark surface. We only restyle (no Template
                 override) so the GridView column-header row is preserved. -->
            <Style TargetType="{x:Type ListView}">
                <Setter Property="Background" Value="{x:Static svc:Theme.ListBg}" />
                <Setter Property="BorderBrush" Value="{x:Static svc:Theme.CardBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{x:Static svc:Theme.TextPrimary}" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
